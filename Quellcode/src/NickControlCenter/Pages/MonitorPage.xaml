<UserControl x:Class="NickControlCenter.MonitorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NickControlCenter">
    <Grid Margin="28,0,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="2,0,12,8">
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource Tab}" Content="Kacheln" GroupName="MT" IsChecked="True" Checked="Tab_Checked" Tag="M1"/>
                <RadioButton Style="{StaticResource Tab}" Content="Diagramme" GroupName="MT" Checked="Tab_Checked" Tag="M2"/>
                <RadioButton Style="{StaticResource Tab}" Content="Alle Sensoren" GroupName="MT" Checked="Tab_Checked" Tag="M3"/>
                <RadioButton Style="{StaticResource Tab}" Content="Overlay &amp; Optionen" GroupName="MT" Checked="Tab_Checked" Tag="M4"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="SourceInfo" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button x:Name="RecBtn" Content="● Aufzeichnen" Click="Rec_Click" Margin="0,0,8,0" ToolTip="Alle Werte jede Sekunde als CSV in den Ordner Logs schreiben (für Excel)"/>
                <Button Content="Min/Max zurücksetzen" Click="Reset_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <!-- Kacheln -->
            <ScrollViewer x:Name="M1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,12,0">
                    <ItemsControl ItemsSource="{Binding TileMetrics}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:Metric}">
                                <Border Style="{StaticResource Card}" Margin="0,0,10,10" Padding="14,12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="60"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Group}" Style="{StaticResource Muted}" FontSize="10.5"/>
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,56,0"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                <Button Style="{StaticResource IconButton}" Content="&#xE76B;" Width="22" Height="22" FontSize="9" Click="Left_Click" ToolTip="nach vorne"/>
                                                <Button Style="{StaticResource IconButton}" Content="&#xE76C;" Width="22" Height="22" FontSize="9" Click="Right_Click" ToolTip="nach hinten"/>
                                                <Button Style="{StaticResource IconButton}" Content="&#xE711;" Width="22" Height="22" FontSize="9" Click="RemoveTile_Click" ToolTip="Kachel entfernen"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="{Binding Text}" Foreground="{Binding Brush}" Style="{StaticResource BigNum}" FontSize="26" Margin="0,4,0,4"/>
                                        <local:Sparkline Grid.Row="2" Metric="{Binding}" Stroke="{DynamicResource AccentBrush}" Points="120"/>
                                        <TextBlock Grid.Row="3" Text="{Binding MinMaxText}" Style="{StaticResource Muted}" FontSize="10.5" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="KACHEL HINZUFÜGEN" Style="{StaticResource Kicker}"/>
                            <TextBlock Style="{StaticResource Caption}" Text="Wähle einen Wert – oder unter „Alle Sensoren“ jeden beliebigen Sensor per „+ Kachel“."/>
                            <ItemsControl x:Name="AddList" Margin="0,10,0,0">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Label}" Tag="{Binding Key}" Margin="0,0,6,6" Padding="10,5" FontSize="12" Click="AddTile_Click"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Diagramme -->
            <Grid x:Name="M2" Visibility="Collapsed" Margin="0,0,12,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Zeitraum" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Border Style="{StaticResource SegmentBox}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" Content="1 min" GroupName="Span" Tag="60" Checked="Span_Checked"/>
                            <RadioButton Style="{StaticResource Segment}" Content="2 min" GroupName="Span" Tag="120" Checked="Span_Checked" IsChecked="True"/>
                            <RadioButton Style="{StaticResource Segment}" Content="5 min" GroupName="Span" Tag="300" Checked="Span_Checked"/>
                            <RadioButton Style="{StaticResource Segment}" Content="10 min" GroupName="Span" Tag="600" Checked="Span_Checked"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <UniformGrid Grid.Row="1" Columns="2">
                    <Border Style="{StaticResource Card}" Margin="0,0,10,10">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock x:Name="C1T" Style="{StaticResource Kicker}"/>
                            <local:Sparkline x:Name="C1" Grid.Row="1" ShowGrid="True" Stroke="#F43F5E"/></Grid>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock x:Name="C2T" Style="{StaticResource Kicker}"/>
                            <local:Sparkline x:Name="C2" Grid.Row="1" ShowGrid="True" Stroke="#FB923C"/></Grid>
                    </Border>
                </UniformGrid>
                <UniformGrid Grid.Row="2" Columns="2">
                    <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock x:Name="C3T" Style="{StaticResource Kicker}"/>
                            <local:Sparkline x:Name="C3" Grid.Row="1" ShowGrid="True" Stroke="{DynamicResource AccentBrush}"/></Grid>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock x:Name="C4T" Style="{StaticResource Kicker}"/>
                            <local:Sparkline x:Name="C4" Grid.Row="1" ShowGrid="True" Stroke="#A78BFA"/></Grid>
                    </Border>
                </UniformGrid>
            </Grid>

            <!-- Alle Sensoren -->
            <Grid x:Name="M3" Visibility="Collapsed" Margin="0,0,12,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="Search" TextChanged="Search_Changed" ToolTip="Suchen, z. B. „Temp“, „Fan“, „GPU“"/>
                    <ComboBox Grid.Column="1" x:Name="KindFilter" Width="170" Margin="8,0,0,0" SelectionChanged="Search_Changed">
                        <ComboBoxItem Content="Alle Arten" IsSelected="True"/>
                        <ComboBoxItem Content="Temperaturen"/>
                        <ComboBoxItem Content="Lüfter"/>
                        <ComboBoxItem Content="Auslastung"/>
                        <ComboBoxItem Content="Takt"/>
                        <ComboBoxItem Content="Leistung"/>
                        <ComboBoxItem Content="Spannung"/>
                    </ComboBox>
                </Grid>
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6">
                    <ListBox x:Name="SensorList" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="2.4*"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Group}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding ValueText}" FontFamily="{StaticResource NumFont}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding MinMax}" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Source}" Style="{StaticResource Muted}" FontSize="10.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    <Button Grid.Column="5" Content="+ Kachel" Style="{StaticResource GhostButton}" FontSize="11.5" Click="PinSensor_Click" Tag="{Binding Id}" Margin="8,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <!-- Overlay & Optionen -->
            <ScrollViewer x:Name="M4" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <UniformGrid Columns="2" Margin="0,0,12,0" VerticalAlignment="Top">
                    <Border Style="{StaticResource Card}" Margin="0,0,10,10">
                        <StackPanel>
                            <TextBlock Text="IN-GAME-OVERLAY" Style="{StaticResource Kicker}"/>
                            <TextBlock Style="{StaticResource Caption}" Text="Kleine Anzeige immer im Vordergrund, klick-durchlässig. Strg+Umschalt+O blendet sie ein/aus. Funktioniert in Spielen mit „Randloses Fenster“. FPS werden über Windows gemessen (nichts wird ins Spiel eingeschleust – Anti-Cheat-sicher), bei DirectX-Spielen."/>
                            <CheckBox Style="{StaticResource ToggleSwitch}" Content="Overlay anzeigen" x:Name="OverlayOn" Click="Overlay_Click" Margin="0,12,0,0"/>
                            <CheckBox Style="{StaticResource ToggleSwitch}" Content="Nebeneinander (von links nach rechts)" IsChecked="{Binding Settings.OverlayHorizontal}" Click="OverlayLayout_Click" Margin="0,8,0,0"/>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBlock Text="Position" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" SelectedIndex="{Binding Settings.OverlayCorner}" SelectionChanged="OverlayChanged">
                                    <ComboBoxItem Content="Oben links"/><ComboBoxItem Content="Oben rechts"/><ComboBoxItem Content="Unten links"/><ComboBoxItem Content="Unten rechts"/><ComboBoxItem Content="Oben Mitte"/>
                                </ComboBox>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBlock Text="Deckkraft" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" Minimum="0.3" Maximum="1" Value="{Binding Settings.OverlayOpacity}" ValueChanged="OverlaySlider"/>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBlock Text="Schriftgröße" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" Minimum="10" Maximum="40" Value="{Binding Settings.OverlayFontSize}" ValueChanged="OverlaySlider" ToolTip="Größe des ganzen Overlays"/>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBlock Text="Schriftart" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" x:Name="FontBox" SelectionChanged="OverlayFont_Changed"/>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBlock Text="Hintergrund" Style="{StaticResource Muted}" VerticalAlignment="Center" ToolTip="Deckkraft des Hintergrunds (0 = komplett durchsichtig, nur Schrift)"/>
                                <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Settings.OverlayBgOpacity}" ValueChanged="OverlaySlider"/>
                            </Grid>
                            <TextBlock Text="Farben" Style="{StaticResource Muted}" Margin="0,12,0,4"/>
                            <ItemsControl x:Name="OverlayColors">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Swatches}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Width="20" Height="20" Margin="0,0,4,0" Tag="{Binding}" Click="OverlaySwatch_Click" Cursor="Hand">
                                                            <Button.Template><ControlTemplate TargetType="Button"><Border CornerRadius="3" Background="{Binding}" BorderBrush="#40FFFFFF" BorderThickness="1"/></ControlTemplate></Button.Template>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBox Grid.Column="2" Text="{Binding Hex, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <CheckBox Style="{StaticResource ToggleSwitch}" Content="Warnfarben (gelb/rot bei hohen Temperaturen)" IsChecked="{Binding Settings.OverlayAlertColors}" Click="OverlayLayout_Click" Margin="0,4,0,0"/>
                            <CheckBox Style="{StaticResource ToggleSwitch}" Content="Rahmen" IsChecked="{Binding Settings.OverlayBorder}" Click="OverlayLayout_Click" Margin="0,8,0,0"/>
                            <TextBlock Text="Angezeigte Werte" Style="{StaticResource Muted}" Margin="0,12,0,6"/>
<TextBlock Style="{StaticResource Caption}" Margin="0,0,0,4" Text="Häkchen = wird angezeigt. ▲▼ = Reihenfolge (oben = ganz links bzw. ganz oben im Overlay)."/>
                            <local:OrderList x:Name="OverlayItems"/>
                        </StackPanel>
                    </Border>
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="MESSQUELLE" Style="{StaticResource Kicker}"/>
                                <TextBlock Style="{StaticResource Caption}" Text="Automatisch: läuft HWiNFO mit „Shared Memory Support“, kommen Temperaturen von dort (sehr genau, kennt jede Hardware). Sonst misst die App selbst."/>
                                <ComboBox x:Name="SourceBox" Margin="0,10,0,0" SelectionChanged="Source_Changed">
                                    <ComboBoxItem Content="Automatisch (HWiNFO, wenn verfügbar)"/>
                                    <ComboBoxItem Content="HWiNFO bevorzugen"/>
                                    <ComboBoxItem Content="Nur eigene Sensoren (LibreHardwareMonitor)"/>
                                </ComboBox>
                                <TextBlock x:Name="HwStatus" Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Messintervall" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" x:Name="IntervalBox" SelectionChanged="Interval_Changed">
                                        <ComboBoxItem Content="0,5 s" Tag="500"/><ComboBoxItem Content="1 s" Tag="1000"/><ComboBoxItem Content="2 s" Tag="2000"/><ComboBoxItem Content="5 s" Tag="5000"/>
                                    </ComboBox>
                                </Grid>
                                <CheckBox Style="{StaticResource ToggleSwitch}" Content="Temperaturen in °F" x:Name="Fahr" Click="Fahr_Click" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="TEMPERATUR-ALARM" Style="{StaticResource Kicker}"/>
                                <CheckBox Style="{StaticResource ToggleSwitch}" Content="Meldung, wenn es zu heiß wird" IsChecked="{Binding Settings.Alarms}"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="CPU ab" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="60" Maximum="100" Value="{Binding Settings.CpuAlarm}" IsSnapToTickEnabled="True" TickFrequency="1"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Settings.CpuAlarm, StringFormat={}{0:0} °C}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="GPU ab" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="60" Maximum="100" Value="{Binding Settings.GpuAlarm}" IsSnapToTickEnabled="True" TickFrequency="1"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Settings.GpuAlarm, StringFormat={}{0:0} °C}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </UniformGrid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
