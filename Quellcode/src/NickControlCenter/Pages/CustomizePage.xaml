<UserControl x:Class="NickControlCenter.CustomizePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NickControlCenter">
    <UserControl.Resources>
        <local:OptKindTemplateSelector x:Key="OptSel">
            <local:OptKindTemplateSelector.Toggle>
                <DataTemplate>
                    <Border Style="{StaticResource SubCard}" Margin="0,0,8,8">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,12,0" VerticalAlignment="Top"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Desc}" Style="{StaticResource Muted}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsOn}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </local:OptKindTemplateSelector.Toggle>
            <local:OptKindTemplateSelector.Choice>
                <DataTemplate>
                    <Border Style="{StaticResource SubCard}" Margin="0,0,8,8">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,12,0" VerticalAlignment="Top"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Desc}" Style="{StaticResource Muted}"/>
                            </StackPanel>
                            <ComboBox Grid.Column="2" ItemsSource="{Binding ChoiceLabels}" SelectedIndex="{Binding ChoiceIndex}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </local:OptKindTemplateSelector.Choice>
        </local:OptKindTemplateSelector>
    </UserControl.Resources>

    <Grid Margin="28,0,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource Card}" Background="{StaticResource InfoSoftBrush}" BorderBrush="#5560A5FA" Margin="0,0,12,10"
                Visibility="{Binding NeedsExplorerRestart, Converter={StaticResource BoolToVis}}">
            <Grid>
                <TextBlock Text="Einige Änderungen werden erst nach einem Explorer-Neustart sichtbar (Taskleiste ist dabei 1–2 Sekunden weg)." TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,160,0"/>
                <Button Content="Explorer neu starten" HorizontalAlignment="Right" Click="Explorer_Click"/>
            </Grid>
        </Border>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="2,0,0,8">
            <RadioButton Style="{StaticResource Tab}" Content="Farben &amp; Themes" GroupName="CT" IsChecked="True" Checked="Tab_Checked" Tag="C1"/>
            <RadioButton Style="{StaticResource Tab}" Content="Hintergrund" GroupName="CT" Checked="Tab_Checked" Tag="C2"/>
            <RadioButton Style="{StaticResource Tab}" Content="Taskleiste &amp; Start" GroupName="CT" Checked="Tab_Checked" Tag="C3"/>
            <RadioButton Style="{StaticResource Tab}" Content="Explorer &amp; Desktop" GroupName="CT" Checked="Tab_Checked" Tag="C4"/>
            <RadioButton Style="{StaticResource Tab}" Content="Effekte, Maus &amp; Werbung" GroupName="CT" Checked="Tab_Checked" Tag="C5"/>
            <RadioButton Style="{StaticResource Tab}" Content="Sicherung" GroupName="CT" Checked="Tab_Checked" Tag="C6"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <!-- Farben -->
            <ScrollViewer x:Name="C1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                            <StackPanel>
                                <TextBlock Text="AKZENTFARBE VON WINDOWS" Style="{StaticResource Kicker}"/>
                                <TextBlock Style="{StaticResource Caption}" Text="Wird jetzt wie über die Windows-Einstellungen angewendet – Startmenü, Taskleiste, Explorer, Einstellungen und Titelleisten übernehmen die Farbe. Dabei öffnen sich kurz die Windows-Einstellungen."/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,10">
                                    <Border Width="48" Height="48" CornerRadius="5" x:Name="CurAccent" BorderBrush="#40FFFFFF" BorderThickness="1"/>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Aktuell" Style="{StaticResource Muted}"/>
                                        <TextBlock Text="{Binding AccentHex}" FontFamily="{StaticResource MonoFont}" FontSize="15"/>
                                    </StackPanel>
                                </StackPanel>
                                <ItemsControl x:Name="AccentGrid">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="12"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Tag="{Binding}" Click="Accent_Click" Height="30" Margin="0,0,5,5" Cursor="Hand" ToolTip="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="b" CornerRadius="4" Background="{Binding}" BorderBrush="#30FFFFFF" BorderThickness="1"/>
                                                        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="White"/><Setter TargetName="b" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="HexBox" FontFamily="{StaticResource MonoFont}" ToolTip="Eigene Farbe als Hex-Code, z. B. #FF5500"/>
                                    <Button Grid.Column="1" Content="Farbe wählen …" Margin="8,0,0,0" Click="Pick_Click"/>
                                    <Button Grid.Column="2" Style="{StaticResource AccentButton}" Content="Übernehmen" Margin="8,0,0,0" Click="Hex_Click"/>
                                </Grid>
                                <TextBlock Text="Zuletzt benutzt" Style="{StaticResource Muted}" Margin="0,10,0,4"/>
                                <ItemsControl x:Name="Recent" ItemTemplate="{Binding ItemTemplate, ElementName=AccentGrid}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="12"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <CheckBox Style="{StaticResource ToggleSwitch}" Content="Akzentfarbe dieser App mit Windows mitändern" IsChecked="{Binding Settings.SyncAppAccent}" Margin="0,10,0,0" Click="Sync_Click"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="HELL / DUNKEL &amp; EFFEKTE" Style="{StaticResource Kicker}"/>
                                <CheckBox Style="{StaticResource ToggleSwitch}" Content="Apps dunkel (Explorer, Einstellungen, Store …)" IsChecked="{Binding DarkApps}" Margin="0,4,0,10"/>
                                <CheckBox Style="{StaticResource ToggleSwitch}" Content="Windows dunkel (Taskleiste, Start, Info-Center)" IsChecked="{Binding DarkSystem}" Margin="0,0,0,10"/>
                                <CheckBox Style="{StaticResource ToggleSwitch}" Content="Transparenz (Milchglas)" IsChecked="{Binding Transparency}" Margin="0,0,0,10"/>
                                <CheckBox Style="{StaticResource ToggleSwitch}" Content="Akzentfarbe auf Start &amp; Taskleiste" IsChecked="{Binding AccentOnTaskbar}" Margin="0,0,0,10"/>
                                <CheckBox Style="{StaticResource ToggleSwitch}" Content="Akzentfarbe auf Titelleisten &amp; Rahmen" IsChecked="{Binding AccentOnTitlebars}"/>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0" Text="Tipp: Akzent auf Start &amp; Taskleiste funktioniert nur im dunklen Windows-Modus (Windows-Vorgabe)."/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock Text="THEMES – EIN KLICK: FARBE, HELL/DUNKEL UND 4K-HINTERGRUND" Style="{StaticResource Kicker}" Margin="0,4,0,8"/>
                    <ItemsControl x:Name="Themes">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,10,10" Click="Theme_Click" Tag="{Binding}" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" CornerRadius="6" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="{StaticResource PanelBrush}" Padding="8">
                                                <StackPanel>
                                                    <Border Height="74" CornerRadius="4" Background="{Binding Preview}">
                                                        <Border Width="18" Height="18" CornerRadius="9" Background="{Binding AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="2,8,0,0" Foreground="{StaticResource TextBrush}"/>
                                                    <TextBlock Text="{Binding Mode}" Style="{StaticResource Muted}" Margin="2,0,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Hintergrund -->
            <ScrollViewer x:Name="C2" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <Grid Margin="0,0,12,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="AKTUELLES HINTERGRUNDBILD" Style="{StaticResource Kicker}"/>
                                <Border CornerRadius="4" ClipToBounds="True" Height="200" Background="{StaticResource InputBrush}">
                                    <Image x:Name="WallImg" Stretch="UniformToFill"/>
                                </Border>
                                <TextBlock x:Name="WallPath" Style="{StaticResource Muted}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Anpassung" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" x:Name="PosBox" ItemsSource="{x:Static local:CustomizeService.PositionNames}" SelectedIndex="4"/>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Bildschirm" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" x:Name="MonBox"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Style="{StaticResource AccentButton}" Content="Bild wählen …" Click="Wall_Click"/>
                                    <Button Content="Einfarbig …" Click="Solid_Click" Margin="8,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="VERLAUF-GENERATOR (4K)" Style="{StaticResource Kicker}"/>
                                <TextBlock Style="{StaticResource Caption}" Text="Erstellt ein eigenes Hintergrundbild aus 2–3 Farben mit Leuchteffekt."/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBox x:Name="G1" Text="#0B0A1F" Width="90" FontFamily="{StaticResource MonoFont}" Margin="0,0,6,0"/>
                                    <TextBox x:Name="G2" Text="#2A1B5C" Width="90" FontFamily="{StaticResource MonoFont}" Margin="0,0,6,0"/>
                                    <TextBox x:Name="G3" Text="#5B2A86" Width="90" FontFamily="{StaticResource MonoFont}" Margin="0,0,6,0"/>
                                    <TextBox x:Name="GG" Text="#A78BFA" Width="90" FontFamily="{StaticResource MonoFont}" ToolTip="Leuchtfarbe"/>
                                </StackPanel>
                                <Button Content="Erstellen &amp; setzen" HorizontalAlignment="Left" Margin="0,10,0,0" Click="Gradient_Click"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="DIASHOW" Style="{StaticResource Kicker}"/>
                                <TextBlock Style="{StaticResource Caption}" Text="Wechselt das Hintergrundbild automatisch aus einem Ordner."/>
                                <TextBlock x:Name="SlideInfo" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Wechsel alle" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" x:Name="SlideMin">
                                        <ComboBoxItem Content="5 Minuten" Tag="5"/><ComboBoxItem Content="15 Minuten" Tag="15"/><ComboBoxItem Content="30 Minuten" Tag="30" IsSelected="True"/>
                                        <ComboBoxItem Content="1 Stunde" Tag="60"/><ComboBoxItem Content="1 Tag" Tag="1440"/>
                                    </ComboBox>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Ordner wählen &amp; starten" Click="Slide_Click"/>
                                    <Button Content="Nächstes Bild" Click="SlideNext_Click" Margin="8,0,0,0"/>
                                    <Button Content="Stoppen" Click="SlideStop_Click" Margin="8,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <ScrollViewer x:Name="C3" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <ItemsControl x:Name="OptTask" ItemTemplateSelector="{StaticResource OptSel}" Margin="0,0,12,0">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" VerticalAlignment="Top"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
            <ScrollViewer x:Name="C4" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <ItemsControl x:Name="OptExplorer" ItemTemplateSelector="{StaticResource OptSel}" Margin="0,0,12,0">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" VerticalAlignment="Top"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
            <ScrollViewer x:Name="C5" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <ItemsControl x:Name="OptFx" ItemTemplateSelector="{StaticResource OptSel}" Margin="0,0,12,0">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" VerticalAlignment="Top"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <ScrollViewer x:Name="C6" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <Border Style="{StaticResource Card}" Margin="0,0,12,0" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="SICHERUNG" Style="{StaticResource Kicker}"/>
                        <TextBlock Style="{StaticResource Caption}" Text="Vor der ersten Änderung jedes Werts wird das Original gespeichert. Hier stellst du alles wieder her, wie es vorher war."/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Style="{StaticResource DangerButton}" Content="Alles auf Original zurücksetzen" Click="Restore_Click"/>
                            <Button Content="Explorer neu starten" Margin="8,0,0,0" Click="Explorer_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
