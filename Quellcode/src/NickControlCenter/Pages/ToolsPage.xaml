<UserControl x:Class="NickControlCenter.ToolsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NickControlCenter"
             PreviewKeyDown="Page_PreviewKeyDown">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,0,16,20">
        <StackPanel Margin="0,0,12,0" MaxWidth="1100" HorizontalAlignment="Left">

            <!-- 1 Programme aktualisieren -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="PROGRAMME AKTUALISIEREN" Style="{StaticResource Kicker}"/>
                            <TextBlock x:Name="UpdSummary" Text="Noch nicht gesucht" Style="{StaticResource H2}" FontSize="15"/>
                            <TextBlock x:Name="UpdTotal" FontSize="12.5" Foreground="{DynamicResource AccentBrush}" Margin="0,3,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button x:Name="UpdSearch" Content="Nach Updates suchen" Click="UpdSearch_Click" Padding="12,5"/>
                            <Button x:Name="UpdAll" Style="{StaticResource AccentButton}" Content="Alle aktualisieren" Click="UpdAll_Click" Padding="14,5" Margin="8,0,0,0" IsEnabled="False"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="Nutzt „winget“, die Paketverwaltung, die in Windows 10/11 eingebaut ist. Updates kommen direkt von den Herstellern. Programme, die gerade laufen (z. B. Discord, Browser), vorher schließen – sonst schlägt das Update fehl. Spiele werden hier nicht angefasst."/>
                    <ProgressBar x:Name="UpdBusy" IsIndeterminate="True" Margin="0,8,0,0" Visibility="Collapsed"/>
                    <ItemsControl x:Name="UpdList" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:AppUpdate}">
                                <Border Style="{StaticResource SubCard}" Margin="0,0,0,5" Padding="10,6" Opacity="{Binding RowOpacity}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Style="{StaticResource Muted}" FontSize="11.5"><Run Text="{Binding Version, Mode=OneWay}"/><Run Text="  →  "/><Run Text="{Binding Available, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}"/><Run Text="   ·   "/><Run Text="{Binding SizeText, Mode=OneWay}"/></TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Status}" VerticalAlignment="Center" Margin="10,0" FontSize="12"/>
                                        <Button Grid.Column="2" Content="{Binding ButtonText}" Padding="10,3" Click="UpdOne_Click" IsEnabled="{Binding CanUpdate}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Spiele aktualisieren (Steam) -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="SPIELE AKTUALISIEREN (STEAM)" Style="{StaticResource Kicker}"/>
                            <TextBlock x:Name="GamesSummary" Text="…" Style="{StaticResource H2}" FontSize="15" TextWrapping="Wrap"/>
                            <TextBlock x:Name="GamesTotal" FontSize="12.5" Foreground="{DynamicResource AccentBrush}" Margin="0,3,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button Content="Neu prüfen" Click="GamesRefresh_Click" Padding="12,5"/>
                            <Button x:Name="GamesAll" Style="{StaticResource AccentButton}" Content="Alle aktualisieren" Click="GamesAll_Click" Padding="14,5" Margin="8,0,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="Liest direkt aus Steam, welche Spiele ein Update haben und wie groß es ist – mit Live-Fortschritt. Neue Versionen werden auch online nachgeschaut – das klappt also auch, wenn Steam gerade nicht läuft. Laden kann ein Spiel-Update nur Steam selbst: „Aktualisieren“ startet Steam unsichtbar im Hintergrund (ohne Fenster), Steam lädt das Update von selbst und hier siehst du Fortschritt, Mbit/s und Restzeit."/>
                    <ItemsControl x:Name="GamesList" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:SteamGameVM}">
                                <Border Style="{StaticResource SubCard}" Margin="0,0,0,5" Padding="10,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}" FontSize="12"/>
                                            <TextBlock Text="{Binding Info}" Style="{StaticResource Muted}" FontSize="11"/>
                                            <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="8" Margin="0,5,0,0" Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <Button Content="{Binding ButtonText}" Style="{StaticResource AccentButton}" Padding="12,4" Click="GameOne_Click"
                                                    Visibility="{Binding ShowButton, Converter={StaticResource BoolToVis}}"/>
                                            <Button Content="In Steam öffnen" Padding="10,3" FontSize="11.5" Margin="0,4,0,0" Click="GameSteam_Click"
                                                    Visibility="{Binding ShowSteamButton, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 2 Downloads aufräumen -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="DOWNLOADS AUFRÄUMEN" Style="{StaticResource Kicker}"/>
                    <TextBlock x:Name="DlSummary" Text="…" Style="{StaticResource H2}" FontSize="15" TextWrapping="Wrap"/>
                    <TextBlock x:Name="DlDetail" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <WrapPanel Margin="0,10,0,0">
                        <Button x:Name="DlSort" Style="{StaticResource AccentButton}" Content="In Ordner sortieren" Click="DlSort_Click" Padding="14,5" Margin="0,0,8,6"/>
                        <Button x:Name="DlOld" Content="Alte Installer in den Papierkorb" Click="DlOld_Click" Padding="12,5" Margin="0,0,8,6"/>
                        <ComboBox x:Name="DlDays" Width="130" Margin="0,0,8,6" SelectionChanged="DlDays_Changed">
                            <ComboBoxItem Content="älter als 14 Tage" Tag="14"/>
                            <ComboBoxItem Content="älter als 30 Tage" Tag="30" IsSelected="True"/>
                            <ComboBoxItem Content="älter als 90 Tage" Tag="90"/>
                        </ComboBox>
                        <Button Content="Ordner öffnen" Click="DlOpen_Click" Padding="12,5" Margin="0,0,8,6"/>
                    </WrapPanel>
                    <CheckBox x:Name="DlWeekly" Style="{StaticResource ToggleSwitch}" Content="Jede Woche automatisch sortieren" Click="DlWeekly_Click" Margin="0,4,0,0"/>
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11.5"
                               Text="Sortiert nur Dateien direkt im Download-Ordner in Unterordner (Bilder, Videos, Musik, Dokumente, Archive, Installer …). Nichts wird gelöscht – außer du klickst auf „Alte Installer“, und die landen im Papierkorb. Dateien, die gerade heruntergeladen werden, bleiben liegen."/>
                </StackPanel>
            </Border>

            <!-- 3 Speicherplatz -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="SPEICHERPLATZ – WAS BELEGT DIE PLATTE?" Style="{StaticResource Kicker}"/>
                    <ItemsControl x:Name="Drives" Margin="0,2,0,6">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Text}" FontSize="12.5"/>
                                        <ProgressBar Value="{Binding Used, Mode=OneWay}" Maximum="100" Height="6" Margin="0,3,0,0" Foreground="{Binding Brush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <Button Content="Was kann weg?" Style="{StaticResource AccentButton}" Tag="{Binding Root}" Click="Quick_Click" Padding="10,3"
                                                ToolTip="Prüft bekannte Platzfresser (Temp, Caches, Papierkorb, Update-Reste …) und sagt, was gefahrlos weg kann"/>
                                        <Button Content="Alle Ordner messen" Tag="{Binding Root}" Click="Analyze_Click" Padding="10,3" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Schnell-Check -->
                    <StackPanel x:Name="QuickPanel" Visibility="Collapsed" Margin="0,8,0,8">
                        <TextBlock x:Name="QuickTitle" Style="{StaticResource H2}" FontSize="15" TextWrapping="Wrap"/>
                        <ProgressBar x:Name="QuickBusy" IsIndeterminate="True" Margin="0,6,0,0" Visibility="Collapsed"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,6">
                            <Border Background="{StaticResource GoodBrush}" Width="10" Height="10" CornerRadius="5"/><TextBlock Text=" kann weg   " FontSize="11.5" Margin="4,0,8,0"/>
                            <Border Background="{StaticResource WarnBrush}" Width="10" Height="10" CornerRadius="5"/><TextBlock Text=" selbst prüfen   " FontSize="11.5" Margin="4,0,8,0"/>
                            <Border Background="{StaticResource BadBrush}" Width="10" Height="10" CornerRadius="5"/><TextBlock Text=" wichtig für Windows – nicht von Hand löschen" FontSize="11.5" Margin="4,0,0,0"/>
                        </StackPanel>
                        <Button x:Name="QuickAll" Style="{StaticResource AccentButton}" HorizontalAlignment="Left" Click="QuickAll_Click" Padding="14,5" Margin="0,0,0,8" Visibility="Collapsed"/>
                        <ItemsControl x:Name="QuickList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:SpaceItem}">
                                    <Border Style="{StaticResource SubCard}" Margin="0,0,0,5" Padding="10,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="6"/><ColumnDefinition/><ColumnDefinition Width="90"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Border Background="{Binding VerdictBrush}" CornerRadius="2"/>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                <TextBlock FontWeight="SemiBold" TextWrapping="Wrap"><Run Text="{Binding Title, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding VerdictText, Mode=OneWay}" Foreground="{Binding VerdictBrush, Mode=OneWay}"/></TextBlock>
                                                <TextBlock Text="{Binding Explain}" Style="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}"/>
                                                <ProgressBar IsIndeterminate="True" Height="4" Margin="0,4,0,0" Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontFamily="{StaticResource NumFont}" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            <Button Grid.Column="3" Content="{Binding ActionLabel}" Click="QuickAction_Click" Padding="10,3" Margin="10,0,0,0" FontSize="11.5" VerticalAlignment="Center"
                                                    IsEnabled="{Binding NotBusy}" Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="Mein Benutzerordner" Click="AnalyzeHome_Click" Padding="10,3" Margin="0,0,8,0"/>
                        <Button x:Name="DiskUp" Content="← Eine Ebene höher" Click="DiskUp_Click" Padding="10,3" Margin="0,0,8,0" IsEnabled="False"/>
                        <Button x:Name="DiskCancel" Content="Abbrechen" Click="DiskCancel_Click" Padding="10,3" Visibility="Collapsed"/>
                    </StackPanel>
                    <TextBlock x:Name="DiskPath" Style="{StaticResource Caption}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
                    <ProgressBar x:Name="DiskBusy" IsIndeterminate="True" Margin="0,6,0,0" Visibility="Collapsed"/>
                    <ItemsControl x:Name="DiskList" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:DirSize}">
                                <Border Style="{StaticResource SubCard}" Margin="0,0,0,4" Padding="10,5" Cursor="Hand" MouseLeftButtonUp="DiskItem_Click"
                                        ToolTip="Klicken, um hineinzuschauen">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontSize="11"><Run Text="{Binding VerdictText, Mode=OneWay}" Foreground="{Binding VerdictBrush, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  ·  " Foreground="{StaticResource MutedBrush}"/><Run Text="{Binding Info, Mode=OneWay}" Foreground="{StaticResource MutedBrush}"/></TextBlock>
                                        </StackPanel>
                                        <Grid Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                                            <ProgressBar Value="{Binding Share, Mode=OneWay}" Maximum="1" Height="8"/>
                                        </Grid>
                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontFamily="{StaticResource NumFont}" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        <Button Grid.Column="3" Content="Öffnen" Padding="8,2" Margin="10,0,0,0" FontSize="11.5" Click="DiskOpen_Click" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Text="{Binding Hint}" FontSize="11.5" Foreground="{Binding VerdictBrush}" TextWrapping="Wrap"
                                                   Margin="0,4,0,0" Visibility="{Binding HasHint, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 6 Automatisch ausschalten -->
            <Border Style="{StaticResource Card}" DataContext="{x:Static local:AutoShutdown.Instance}">
                <StackPanel>
                    <TextBlock Text="AUTOMATISCH AUSSCHALTEN" Style="{StaticResource Kicker}"/>
                    <WrapPanel Margin="0,4,0,0">
                        <TextBlock Text="Wann:" VerticalAlignment="Center" Margin="0,0,8,6"/>
                        <ComboBox ItemsSource="{x:Static local:AutoShutdown.WhenNames}" SelectedIndex="{Binding WhenIndex}" Width="240" Margin="0,0,16,6"/>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding ShowMinutes, Converter={StaticResource BoolToVis}}" Margin="0,0,16,6">
                            <TextBox Text="{Binding Minutes, UpdateSourceTrigger=LostFocus}" Width="60" VerticalContentAlignment="Center"/>
                            <TextBlock Text="Minuten" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="Dann:" VerticalAlignment="Center" Margin="0,0,8,6"/>
                        <ComboBox ItemsSource="{x:Static local:AutoShutdown.ActionNames}" SelectedIndex="{Binding ActionIndex}" Width="160" Margin="0,0,0,6"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource H2}" FontSize="14" Margin="0,6,0,0" Foreground="{DynamicResource AccentBrush}"
                               Visibility="{Binding Active, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="„Wenn der Download fertig ist“ funktioniert mit Steam, Epic, Battle.net und allem anderen: Sobald ein Download läuft und danach 3 Minuten lang fast nichts mehr kommt, geht’s los. „Nicht benutzt“ wartet auf keine Maus-/Tastatureingabe UND einen ruhigen PC. Vorher erscheint immer 60 Sekunden lang ein Fenster mit „Abbrechen“. Die Einstellung gilt nur einmal und ist nach dem Neustart wieder aus."/>
                </StackPanel>
            </Border>

            <!-- 7 Tastenkürzel -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="TASTENKÜRZEL (ÜBERALL, AUCH IM SPIEL)" Style="{StaticResource Kicker}"/>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Funktionieren auch, wenn das Control Center nur im Tray läuft. Zum Ändern auf „Ändern“ klicken und die neue Kombination drücken (mindestens Strg, Alt oder Win dazu). Esc bricht ab."/>
                    <ItemsControl x:Name="Keys">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:HotkeyVM}">
                                <Border Style="{StaticResource SubCard}" Margin="0,0,0,5" Padding="10,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding State}" Foreground="{StaticResource WarnBrush}" FontSize="11.5" Visibility="{Binding HasState, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="{StaticResource PanelAltBrush}" CornerRadius="4" Padding="10,4" Margin="10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding KeyText}" FontFamily="{StaticResource MonoFont}" FontSize="12.5"/>
                                        </Border>
                                        <Button Grid.Column="3" Content="{Binding RecordText}" Padding="10,3" Click="KeyRecord_Click" VerticalAlignment="Center" MinWidth="110"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
