<UserControl x:Class="NickControlCenter.StartupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NickControlCenter">
    <Grid Margin="28,0,16,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}" Margin="0,0,12,10">
            <Grid>
                <StackPanel>
                    <TextBlock Text="AUTOSTART-PROGRAMME" Style="{StaticResource Kicker}"/>
                    <TextBlock x:Name="Summary" Style="{StaticResource H2}" FontSize="15"/>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="Jedes Programm hier startet mit Windows und macht den PC beim Hochfahren langsamer. Grün = kann aus, Gelb = nach Bedarf, Rot = an lassen. Ausschalten funktioniert wie im Task-Manager: nichts wird gelöscht, du kannst es jederzeit wieder einschalten."/>
                    <Border Background="{StaticResource PanelAltBrush}" CornerRadius="6" Padding="12,8" Margin="0,10,0,0" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="SelfAuto" Style="{StaticResource ToggleSwitch}" Click="SelfAuto_Click" VerticalAlignment="Center"/>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock Text="Control Center mit Windows starten" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SelfAutoText" Style="{StaticResource Muted}" FontSize="11.5"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Content="Neu laden" Click="Reload_Click" Padding="12,4"/>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Items" Margin="0,0,12,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:StartupItem}">
                        <Border Style="{StaticResource SubCard}" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Enabled}" VerticalAlignment="Top" Margin="0,2,12,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Style="{StaticResource Muted}" FontSize="11.5" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding StateText, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Publisher, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Location, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Command}" Style="{StaticResource Muted}" FontSize="11" FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Command}"/>
                                    <TextBlock Text="{Binding Advice}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{Binding VerdictBrush}"
                                               Visibility="{Binding HasAdvice, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="10,0,0,0" HorizontalAlignment="Right">
                                    <Border CornerRadius="3" Padding="9,3" HorizontalAlignment="Right" BorderBrush="{Binding VerdictBrush}" BorderThickness="1" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding VerdictText}" FontSize="12" FontWeight="Bold" Foreground="{Binding VerdictBrush}"/>
                                    </Border>
                                    <Border CornerRadius="3" Padding="7,2" HorizontalAlignment="Right" Background="{StaticResource PanelAltBrush}">
                                        <TextBlock Text="{Binding Impact}" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding ImpactBrush}"/>
                                    </Border>
                                    <Button Content="Ordner" Padding="8,2" FontSize="11.5" Margin="0,6,0,0" HorizontalAlignment="Right" Click="Folder_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
