<UserControl x:Class="NickControlCenter.LogPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,0,28,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="FileBox" Width="190" SelectionChanged="File_Changed">
                    <ComboBoxItem Content="Gesamt" IsSelected="True"/><ComboBoxItem Content="Allgemein"/><ComboBoxItem Content="Luefter"/><ComboBoxItem Content="Beleuchtung"/>
                    <ComboBoxItem Content="Boost"/><ComboBoxItem Content="Monitor"/><ComboBoxItem Content="Stresstest"/><ComboBoxItem Content="Tweaker"/><ComboBoxItem Content="Problemloeser"/>
                </ComboBox>
                <ComboBox x:Name="LevelBox" Width="170" Margin="8,0,0,0" SelectionChanged="File_Changed">
                    <ComboBoxItem Content="Alle Einträge" IsSelected="True"/><ComboBoxItem Content="Nur Warnungen + Fehler"/><ComboBoxItem Content="Nur Fehler"/>
                </ComboBox>
                <TextBox x:Name="Filter" Width="220" Margin="8,0,0,0" TextChanged="Filter_Changed" ToolTip="Suchen"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <CheckBox Style="{StaticResource ToggleSwitch}" Content="Live" x:Name="Live" IsChecked="True" Margin="0,4,14,0"/>
                <Button Content="Kopieren" Click="Copy_Click" Margin="0,0,8,0"/>
                <Button Content="Ordner „Logs“ öffnen" Click="Folder_Click"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10">
            <TextBox x:Name="Text" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="12" BorderThickness="0" Background="Transparent"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" VerticalContentAlignment="Top" Padding="0"/>
        </Border>
    </Grid>
</UserControl>
