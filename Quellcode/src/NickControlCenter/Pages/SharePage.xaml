<UserControl x:Class="NickControlCenter.SharePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NickControlCenter">
    <UserControl.Resources>
                            <DataTemplate x:Key="TransferTemplate" DataType="{x:Type local:Transfer}">
                                <Border Style="{StaticResource SubCard}" Margin="0,0,0,5" Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis"><Run Text="{Binding Direction, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding Name, Mode=OneWay}"/></TextBlock>
                                            <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="8" Margin="0,6,0,5"/>
                                            <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" MinWidth="150" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Speed}" FontFamily="{StaticResource NumFont}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding Amount}" FontFamily="{StaticResource NumFont}" FontSize="12.5" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <Button Content="Öffnen" Click="FOpenResult_Click" Tag="{Binding}" Padding="10,3" Margin="0,0,6,0" Visibility="{Binding OpenVisibility}"/>
                                            <Button Content="{Binding ButtonText}" Click="FCancel_Click" Tag="{Binding}" Padding="10,3"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
    </UserControl.Resources>
    <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="30,0,0,8">
        <RadioButton x:Name="TabHost" Style="{StaticResource Tab}" Content="Meine Freigabe" GroupName="ST" Checked="Tab_Checked" Tag="host"/>
        <RadioButton x:Name="TabFriend" Style="{StaticResource Tab}" Content="Bei einem Freund" GroupName="ST" Checked="Tab_Checked" Tag="friend"/>
    </StackPanel>
    <ScrollViewer x:Name="HostView" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,0,16,20">
        <StackPanel Margin="0,0,12,0" MaxWidth="1100" HorizontalAlignment="Left">

            <!-- Status -->
            <Border Style="{StaticResource AccentCard}">
                <StackPanel>
                    <Grid>
                        <StackPanel Margin="0,0,70,0">
                            <TextBlock Text="DATEIFREIGABE FÜR FREUNDE" Style="{StaticResource Kicker}"/>
                            <TextBlock x:Name="StateText" Text="Aus" Style="{StaticResource H2}"/>
                            <TextBlock x:Name="StateSub" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="Dein eigener File Share im Control Center: Deine Freunde verbinden sich mit ihrem Control Center und laden Dateien bis 100 GB hoch und runter. Abgebrochene Übertragungen laufen weiter, wo sie aufgehört haben."/>
                        </StackPanel>
                        <CheckBox x:Name="Toggle" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="Toggle_Click"/>
                    </Grid>
                    <TextBlock x:Name="TunnelText" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <Border x:Name="ErrorBox" Background="{StaticResource BadSoftBrush}" CornerRadius="4" Padding="12,8" Margin="0,10,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="ErrorText" Foreground="{StaticResource BadBrush}" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Anfragen -->
            <Border x:Name="RequestsCard" Style="{StaticResource AccentCard}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="ANFRAGEN" Style="{StaticResource Kicker}"/>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,8" Text="Diese Freunde möchten sich mit deinem Download Center verbinden. Nur erlauben, wenn du weißt, wer das ist."/>
                    <ItemsControl x:Name="RequestList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:JoinRequest}">
                                <Border Style="{StaticResource SubCard}" Margin="0,0,0,5" Padding="10,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock FontWeight="SemiBold"><Run Text="{Binding Name, Mode=OneWay}"/><Run Text=" möchte sich verbinden"/></TextBlock>
                                            <TextBlock Text="{Binding Info}" Style="{StaticResource Muted}" FontSize="11.5"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Style="{StaticResource AccentButton}" Content="Erlauben" Click="Approve_Click" Tag="{Binding Id}" Padding="14,4"/>
                                            <Button Style="{StaticResource DangerButton}" Content="Ablehnen" Click="Deny_Click" Tag="{Binding Id}" Padding="10,4" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Freunde mit Zugang -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="FREUNDE MIT ZUGANG" Style="{StaticResource Kicker}"/>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,8"
                               Text="Deine Freunde brauchen nichts von dir: Sie öffnen in ihrem Control Center „Dateifreigabe → Bei einem Freund“, dein Download Center wird automatisch gefunden, sie klicken auf „Verbinden“ – und du bekommst hier eine Anfrage zum Erlauben."/>
                    <TextBlock x:Name="NoMembers" Text="Noch niemand." Style="{StaticResource Muted}"/>
                    <ItemsControl x:Name="MemberList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ShareMember}">
                                <Border Style="{StaticResource SubCard}" Margin="0,0,0,5" Padding="10,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding LastSeenText}" Style="{StaticResource Muted}" FontSize="11.5"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Zugang entfernen" Click="RemoveMember_Click" Tag="{Binding}" Padding="10,3" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="200"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Text="So heißt du bei deinen Freunden:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="OwnerBox" Grid.Column="1" Padding="6,3" MaxLength="30" LostFocus="OwnerBox_LostFocus"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Einladungs-Code -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="ALTERNATIV: EINLADUNGS-CODE" Style="{StaticResource Kicker}"/>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,8"
                               Text="Nur nötig, falls das automatische Finden bei einem Freund nicht klappt (z. B. ohne Internet-Tunnel). Der Code enthält das Passwort, also nur an Freunde schicken."/>
                    <Grid>
                        <TextBox x:Name="InviteBox" IsReadOnly="True" Padding="6,4" Margin="0,0,90,0" FontFamily="{StaticResource MonoFont}" FontSize="11"/>
                        <Button Content="Kopieren" Click="CopyInvite_Click" HorizontalAlignment="Right" Width="84"/>
                    </Grid>
                    <TextBlock x:Name="InviteHint" Style="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <Grid Margin="0,12,0,0">
                        <TextBlock Text="Auch im Browser erreichbar (für Freunde ohne Control Center)" VerticalAlignment="Center"/>
                        <CheckBox x:Name="BrowserToggle" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" Click="BrowserToggle_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Links für den Browser (nur für Freunde ohne Control Center) -->
            <Border x:Name="BrowserCard" Style="{StaticResource Card}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="LINKS FÜR DEN BROWSER" Style="{StaticResource Kicker}"/>
                    <ItemsControl x:Name="LinkList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SubCard}" Margin="0,0,0,6" Padding="10,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Kind}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding Url, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="12" Padding="6,3" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                                            <Button Content="Kopieren" Click="Copy_Click" Tag="{Binding Url}" Padding="10,3"/>
                                            <Button Content="Öffnen" Click="Open_Click" Tag="{Binding Url}" Padding="10,3" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="LinkHint" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="Nur für Freunde ohne Control Center: Link im Browser öffnen, mit Namen und Passwort anmelden. Der Internet-Link ändert sich bei jedem Start der Freigabe."/>
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- Übersicht -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="ÜBERSICHT" Style="{StaticResource Kicker}"/>
                        <UniformGrid Columns="3" Margin="0,6,0,0">
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock x:Name="SFiles" Text="–" Style="{StaticResource BigNum}" FontSize="24"/>
                                <TextBlock Text="Dateien" Style="{StaticResource Muted}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock x:Name="SUsed" Text="–" Style="{StaticResource BigNum}" FontSize="24"/>
                                <TextBlock Text="belegt" Style="{StaticResource Muted}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock x:Name="SFree" Text="–" Style="{StaticResource BigNum}" FontSize="24"/>
                                <TextBlock Text="frei auf der Platte" Style="{StaticResource Muted}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock x:Name="SUp" Text="–" Style="{StaticResource BigNum}" FontSize="24"/>
                                <TextBlock Text="↑ an Freunde" Style="{StaticResource Muted}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock x:Name="SDown" Text="–" Style="{StaticResource BigNum}" FontSize="24"/>
                                <TextBlock Text="↓ von Freunden" Style="{StaticResource Muted}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock x:Name="SActive" Text="–" Style="{StaticResource BigNum}" FontSize="24"/>
                                <TextBlock Text="laufende Übertragungen" Style="{StaticResource Muted}"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Tempo -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="SO SCHNELL LADEN DEINE FREUNDE" Style="{StaticResource Kicker}"/>
                        <TextBlock x:Name="SpeedHead" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,6"/>
                        <TextBlock x:Name="SpeedTable" FontFamily="{StaticResource MonoFont}" FontSize="12.5" Margin="0,0,0,6"/>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="Die Dateien liegen auf deinem PC – wenn Freunde herunterladen, schickt dein PC sie los. Deshalb zählt dein Upload (oder ihr Download, falls der langsamer ist). Laden mehrere gleichzeitig, teilen sie sich deinen Upload."/>
                        <Button Content="Speedtest machen (Werkzeuge)" Click="Speed_Click" HorizontalAlignment="Left" Padding="10,4" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Dateien -->
            <Border Style="{StaticResource Card}" AllowDrop="True" Drop="HDrop" DragOver="FDragOver">
                <StackPanel>
                    <Grid>
                        <TextBlock x:Name="HFilesTitle" Text="DEINE GETEILTEN DATEIEN" Style="{StaticResource Kicker}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Speicherordner öffnen" Click="OpenFolder_Click" Padding="10,3"/>
                            <Button Style="{StaticResource DangerButton}" Content="Alles löschen" Click="HDeleteAll_Click" Padding="10,3" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Style="{StaticResource AccentButton}" Content="Hochladen ▾" Click="UploadMenu_Click" Tag="host" Padding="16,5"/>
                        <TextBlock Text="Kategorie:" VerticalAlignment="Center" Margin="14,0,6,0"/>
                        <Grid Width="230"><TextBox x:Name="HCategory" Text="Sonstiges" Padding="6,4" Margin="0,0,34,0" MaxLength="40" VerticalContentAlignment="Center" ToolTip="Kategorie frei eintippen oder rechts aus den vorhandenen wählen"/><Button Content="▾" Width="30" HorizontalAlignment="Right" Click="CategoryPick_Click" Tag="HCategory" ToolTip="Vorhandene Kategorien"/></Grid>
                        <TextBlock Text="Herunterladen nach:" VerticalAlignment="Center" Style="{StaticResource Muted}" Margin="18,0,6,0"/>
                        <TextBlock x:Name="HFolder" VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                        <Button Content="Ändern …" Click="FFolder_Click" Padding="8,3" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="Oder Dateien und Ordner einfach hierher ziehen – deine Freunde sehen sie sofort in ihrer App. Ordner werden als .zip geteilt (mit allen Unterordnern)."/>
                    <ItemsControl x:Name="HTransfers" Margin="0,8,0,0" ItemTemplate="{StaticResource TransferTemplate}"/>
                    <TextBlock x:Name="NoFiles" Text="Noch keine Dateien." Style="{StaticResource Muted}" Margin="0,8,0,0"/>
                    <ItemsControl x:Name="FileList" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SubCard}" Margin="0,0,0,5" Padding="10,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Info}" Style="{StaticResource Muted}" FontSize="11.5"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Herunterladen" Click="HExport_Click" Tag="{Binding}" Padding="10,3" Margin="0,0,6,0"/>
                                            <Button Style="{StaticResource DangerButton}" Content="Löschen" Click="Delete_Click" Tag="{Binding}" Padding="10,3"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Einstellungen -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="EINSTELLUNGEN" Style="{StaticResource Kicker}"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Name der Seite" VerticalAlignment="Center"/>
                        <TextBox x:Name="TitleBox" Grid.Column="1" Padding="6,4" Margin="0,0,0,8" MaxLength="60"/>

                        <TextBlock Grid.Row="1" Text="Passwort für Freunde" VerticalAlignment="Center"/>
                        <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                            <PasswordBox x:Name="PwBox" Padding="6,4" Margin="0,0,90,0"/>
                            <TextBox x:Name="PwPlain" Padding="6,4" Margin="0,0,90,0" Visibility="Collapsed"/>
                            <CheckBox x:Name="ShowPw" Content="Anzeigen" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ShowPw_Click"/>
                        </Grid>

                        <TextBlock Grid.Row="2" Text="Admin-Passwort (nur du)" VerticalAlignment="Center" ToolTip="Wer sich damit anmeldet, kann auf der Webseite Dateien löschen."/>
                        <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,8">
                            <PasswordBox x:Name="AdminBox" Padding="6,4" Margin="0,0,90,0"/>
                            <TextBox x:Name="AdminPlain" Padding="6,4" Margin="0,0,90,0" Visibility="Collapsed"/>
                        </Grid>

                        <TextBlock Grid.Row="3" Text="Speicherordner" VerticalAlignment="Center"/>
                        <Grid Grid.Row="3" Grid.Column="1" Margin="0,0,0,8">
                            <TextBox x:Name="FolderBox" IsReadOnly="True" Padding="6,4" Margin="0,0,90,0"/>
                            <Button Content="Ändern …" Click="Folder_Click" HorizontalAlignment="Right" Width="84"/>
                        </Grid>

                        <TextBlock Grid.Row="4" Text="Port (Verbindung der Apps)" VerticalAlignment="Center" ToolTip="Über diesen Eingang verbinden sich die Apps deiner Freunde mit deinem PC. Nur ändern, wenn ein anderes Programm ihn schon benutzt."/>
                        <TextBox x:Name="PortBox" Grid.Row="4" Grid.Column="1" Width="100" HorizontalAlignment="Left" Padding="6,4" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="5" Text="Max. Größe pro Datei (GB)" VerticalAlignment="Center"/>
                        <TextBox x:Name="MaxBox" Grid.Row="5" Grid.Column="1" Width="100" HorizontalAlignment="Left" Padding="6,4" Margin="0,0,0,8"/>

                        <CheckBox x:Name="InternetBox" Grid.Row="6" Grid.ColumnSpan="2" Margin="0,2,0,0"
                                  Content="Übers Internet erreichbar (Cloudflare-Tunnel – sonst nur Heimnetz und Tailscale)"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource AccentButton}" Content="Speichern" Click="Save_Click" Padding="18,5"/>
                        <TextBlock x:Name="SaveMsg" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Aktivität -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="AKTIVITÄT" Style="{StaticResource Kicker}"/>
                    <TextBox x:Name="ActivityBox" IsReadOnly="True" Height="170" Margin="0,8,0,0" Padding="8,6" TextWrapping="NoWrap"
                             FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>

    <!-- ================= Bei einem Freund ================= -->
    <ScrollViewer x:Name="FriendView" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,0,16,20" Visibility="Collapsed">
        <StackPanel Margin="0,0,12,0" MaxWidth="1100" HorizontalAlignment="Left">

            <!-- Verbinden -->
            <Border Style="{StaticResource AccentCard}">
                <StackPanel>
                    <TextBlock Text="DOWNLOAD CENTER EINES FREUNDES" Style="{StaticResource Kicker}"/>
                    <TextBlock x:Name="FState" Text="Noch nicht verbunden" Style="{StaticResource H2}"/>
                    <TextBlock x:Name="FSub" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <StackPanel x:Name="FSetup" Margin="0,10,0,0">
                        <TextBlock x:Name="FFoundText" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="FJoinBtn" Style="{StaticResource AccentButton}" Content="Verbinden" Click="FJoin_Click" Padding="16,5"/>
                            <Button x:Name="FJoinCancel" Content="Abbrechen" Click="FJoinCancel_Click" Padding="10,4" Margin="8,0,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                        <TextBlock x:Name="FJoinState" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <CheckBox x:Name="FShowCode" Content="Stattdessen einen Einladungs-Code eingeben" Margin="0,12,0,0" Click="FShowCode_Click"/>
                        <Grid x:Name="FCodeRow" Margin="0,6,0,0" Visibility="Collapsed">
                            <TextBox x:Name="FCodeBox" Padding="6,4" Margin="0,0,100,0" FontFamily="{StaticResource MonoFont}" FontSize="11"/>
                            <Button Content="Verbinden" Click="FConnect_Click" HorizontalAlignment="Right" Width="94"/>
                        </Grid>
                    </StackPanel>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Text="Dein Name beim Freund:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="FMyName" Grid.Column="1" Padding="6,3" LostFocus="FMyName_LostFocus"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="FRefreshBtn" Content="Aktualisieren" Click="FRefresh_Click" Padding="10,3"/>
                            <Button x:Name="FForgetBtn" Content="Trennen / anderer Code" Click="FForget_Click" Padding="10,3" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Hochladen -->
            <Border x:Name="FUploadCard" Style="{StaticResource Card}" AllowDrop="True" Drop="FDrop" DragOver="FDragOver">
                <StackPanel>
                    <TextBlock Text="HOCHLADEN" Style="{StaticResource Kicker}"/>
                    <Grid Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource AccentButton}" Content="Hochladen ▾" Click="UploadMenu_Click" Tag="friend" Padding="16,5"/>
                            <TextBlock Text="Kategorie:" VerticalAlignment="Center" Margin="14,0,6,0"/>
                            <Grid Width="230"><TextBox x:Name="FCategory" Text="Sonstiges" Padding="6,4" Margin="0,0,34,0" MaxLength="40" VerticalContentAlignment="Center" ToolTip="Kategorie frei eintippen oder rechts aus den vorhandenen wählen"/><Button Content="▾" Width="30" HorizontalAlignment="Right" Click="CategoryPick_Click" Tag="FCategory" ToolTip="Vorhandene Kategorien"/></Grid>
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="Oder Dateien und Ordner einfach hierher ziehen. Ordner werden als .zip hochgeladen (mit allen Unterordnern). Bricht etwas ab (oder du pausierst), dasselbe nochmal wählen und es geht an der Stelle weiter."/>
                </StackPanel>
            </Border>

            <!-- Übertragungen -->
            <Border x:Name="FTransfersCard" Style="{StaticResource Card}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="ÜBERTRAGUNGEN" Style="{StaticResource Kicker}"/>
                    <ItemsControl x:Name="FTransfers" Margin="0,6,0,0" ItemTemplate="{StaticResource TransferTemplate}">
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Dateien des Freundes -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <TextBlock x:Name="FFilesTitle" Text="DATEIEN" Style="{StaticResource Kicker}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="FFree" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                            <Button x:Name="FDeleteAllBtn" Style="{StaticResource DangerButton}" Content="Alles löschen" Click="FDeleteAll_Click" Padding="10,3" Margin="10,0,0,0"
                                    ToolTip="Löscht alles, was du bei deinem Freund hochgeladen hast"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="FSearch" Padding="6,4" TextChanged="FSearch_Changed" ToolTip="Suchen"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                            <TextBlock Text="Speichern in:" VerticalAlignment="Center" Style="{StaticResource Muted}" Margin="0,0,6,0"/>
                            <TextBlock x:Name="FFolder" VerticalAlignment="Center" MaxWidth="260" TextTrimming="CharacterEllipsis"/>
                            <Button Content="Ändern …" Click="FFolder_Click" Padding="8,3" Margin="8,0,0,0"/>
                            <Button Content="Öffnen" Click="FOpenFolder_Click" Padding="8,3" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="FNoFiles" Text="Keine Dateien." Style="{StaticResource Muted}" Margin="0,10,0,0" Visibility="Collapsed"/>
                    <ItemsControl x:Name="FFiles" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:RemoteFile}">
                                <Border Style="{StaticResource SubCard}" Margin="0,0,0,5" Padding="10,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Info}" Style="{StaticResource Muted}" FontSize="11.5"/>
                                            <TextBlock Text="{Binding Note}" FontSize="11.5" TextWrapping="Wrap" Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource AccentButton}" Content="Herunterladen" Click="FDownload_Click" Tag="{Binding}" Padding="12,4"/>
                                            <Button Style="{StaticResource DangerButton}" Content="Löschen" Click="FDeleteOne_Click" Tag="{Binding}" Padding="10,4" Margin="6,0,0,0"
                                                    Visibility="{Binding DeleteVisibility}" ToolTip="Deine eigene Datei löschen"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
    </Grid>
</UserControl>
