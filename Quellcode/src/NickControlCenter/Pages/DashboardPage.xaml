<UserControl x:Class="NickControlCenter.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NickControlCenter">
    <UserControl.Resources>
        <!-- große Messwert-Karte -->
        <DataTemplate x:Key="KpiTemplate" DataType="{x:Type local:Metric}">
            <Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="46"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" FontSize="11.5"/>
                    <TextBlock Grid.Row="1" Text="{Binding Text}" Foreground="{Binding Brush}" Style="{StaticResource BigNum}" FontSize="28" Margin="0,2,0,4"/>
                    <local:Sparkline Grid.Row="2" Metric="{Binding}" Stroke="{DynamicResource AccentBrush}" Points="90"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,0,16,20">
        <StackPanel x:Name="Root">
            <!-- Dashboard anpassen -->
            <Grid x:Name="EditBar" Margin="0,0,12,8">
                <Button HorizontalAlignment="Right" Click="Edit_Click" x:Name="EditBtn" Padding="12,5" FontSize="12">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE70F;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="Dashboard anpassen"/></StackPanel>
                </Button>
            </Grid>
            <Border x:Name="EditPanel" Style="{StaticResource AccentCard}" Margin="0,0,12,12" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="DASHBOARD ANPASSEN" Style="{StaticResource Kicker}"/>
                    <TextBlock Style="{StaticResource Caption}" Text="Häkchen = wird angezeigt. Mit ▲▼ sortierst du: was oben steht, kommt zuerst. Änderungen gelten sofort."/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Bereiche" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <local:OrderList x:Name="SecList"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                            <TextBlock Text="Karten" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <local:OrderList x:Name="CardList"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Kennzahlen (große Werte)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto"><local:OrderList x:Name="KpiList"/></ScrollViewer>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource AccentButton}" Content="Fertig" Click="Edit_Click"/>
                        <Button Content="Standard wiederherstellen" Margin="8,0,0,0" Click="EditReset_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <!-- Systemzeile -->
            <Border x:Name="SecSystem" Style="{StaticResource SubCard}" Margin="0,0,12,14" Padding="14,10">
                <WrapPanel>
                    <TextBlock Text="&#xE950;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                    <TextBlock x:Name="CpuText" Margin="0,0,22,0"/>
                    <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                    <TextBlock x:Name="GpuText" Margin="0,0,22,0"/>
                    <TextBlock Text="&#xE964;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                    <TextBlock x:Name="RamText" Margin="0,0,22,0"/>
                    <TextBlock x:Name="SourceText" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                </WrapPanel>
            </Border>

            <!-- Kennzahlen -->
            <ItemsControl x:Name="Kpis" ItemTemplate="{StaticResource KpiTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- Module -->
            <UniformGrid x:Name="Cards" Columns="3" Margin="0,4,0,0">
                <!-- Lüfter -->
                <Border x:Name="CardFans" Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="LÜFTER" Style="{StaticResource Kicker}"/>
                            <TextBlock Text="{Binding Fans.StateText}" Foreground="{Binding Fans.StateBrush}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                        </Grid>
                        <TextBlock Text="{Binding Fans.Summary}" Style="{StaticResource Caption}" Margin="0,2,0,10"/>
                        <Border Style="{StaticResource SegmentBox}">
                            <UniformGrid Columns="3">
                                <RadioButton Style="{StaticResource Segment}" Content="Leise" GroupName="FanProf" Checked="FanProfile_Checked" x:Name="ProfQuiet"/>
                                <RadioButton Style="{StaticResource Segment}" Content="Normal" GroupName="FanProf" Checked="FanProfile_Checked" x:Name="ProfNormal"/>
                                <RadioButton Style="{StaticResource Segment}" Content="Leistung" GroupName="FanProf" Checked="FanProfile_Checked" x:Name="ProfPerf"/>
                            </UniformGrid>
                        </Border>
                        <CheckBox Style="{StaticResource ToggleSwitch}" Content="Pausieren (BIOS regelt)" IsChecked="{Binding Fans.Paused}" Margin="0,12,0,0"/>
                        <Button Content="Zu den Lüftern" HorizontalAlignment="Left" Margin="0,12,0,0" Click="Go_Click" Tag="Lüfter"/>
                    </StackPanel>
                </Border>

                <!-- Beleuchtung -->
                <Border x:Name="CardRgb" Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="BELEUCHTUNG" Style="{StaticResource Kicker}"/>
                            <TextBlock Text="{Binding Fans.Rgb.EffectName}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                        </Grid>
                        <TextBlock Text="{Binding Fans.Rgb.StatusText}" Foreground="{Binding Fans.Rgb.StatusBrush}" Style="{StaticResource Caption}" Margin="0,2,0,10"/>
                        <Border Height="14" CornerRadius="3" Background="{Binding Fans.Rgb.GlobalPreview}" Margin="0,0,0,12"/>
                        <CheckBox Style="{StaticResource ToggleSwitch}" Content="Beleuchtung an" IsChecked="{Binding Fans.Rgb.Enabled}"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Helligkeit" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Fans.Rgb.Brightness}" Margin="10,0"/>
                            <TextBlock Grid.Column="2" Text="{Binding Fans.Rgb.BrightnessText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Button Content="Zur Beleuchtung" HorizontalAlignment="Left" Margin="0,12,0,0" Click="Go_Click" Tag="Beleuchtung"/>
                    </StackPanel>
                </Border>

                <!-- Boost -->
                <Border x:Name="CardBoost" Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="FPS-BOOST" Style="{StaticResource Kicker}"/>
                        <TextBlock Text="{Binding Boost.Status}" Style="{StaticResource H2}" FontSize="14" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Boost.LastBoostText}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding Boost.AutoStatus}" Style="{StaticResource Muted}" Margin="0,2,0,12"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource AccentButton}" Padding="22,9" Click="Boost_Click" IsEnabled="{Binding Boost.NotBusy}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7FC;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="BOOST"/>
                                </StackPanel>
                            </Button>
                            <Button Content="RAM freigeben" Margin="8,0,0,0" Click="Ram_Click"/>
                        </StackPanel>
                        <Button Content="Zum FPS-Boost" HorizontalAlignment="Left" Margin="0,12,0,0" Click="Go_Click" Tag="FPS-Boost"/>
                    </StackPanel>
                </Border>

                <!-- Strom -->
                <Border x:Name="CardPower" Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="STROMVERBRAUCH" Style="{StaticResource Kicker}"/>
                        <TextBlock x:Name="PowerNow" Style="{StaticResource BigNum}" FontSize="26"/>
                        <TextBlock x:Name="PowerText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="70"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="Strompreis €/kWh" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" x:Name="PriceBox" FontFamily="{StaticResource MonoFont}" LostFocus="Price_LostFocus"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Treiber -->
                <Border x:Name="CardDrivers" Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="GRAFIKTREIBER" Style="{StaticResource Kicker}"/>
                        <TextBlock Text="{Binding Drivers.Status}" Style="{StaticResource Caption}"/>
                        <ItemsControl ItemsSource="{Binding Drivers.Rows}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <TextBlock Text="{Binding Title}" FontSize="12"/>
                                        <TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="12"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Treiber prüfen" HorizontalAlignment="Left" Margin="0,12,0,0" Click="Go_Click" Tag="Treiber"/>
                    </StackPanel>
                </Border>
                <!-- Tweaker -->
                <Border x:Name="CardTweaker" Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="TWEAKER" Style="{StaticResource Kicker}"/>
                        <TextBlock x:Name="TweakCpu" Style="{StaticResource Caption}"/>
                        <TextBlock x:Name="TweakGpu" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                        <Button Content="Zum Tweaker" HorizontalAlignment="Left" Margin="0,12,0,0" Click="Go_Click" Tag="Tweaker"/>
                    </StackPanel>
                </Border>
                <!-- Kacheln / Stresstest -->
                <Border x:Name="CardExtras" Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="SCHNELLZUGRIFF" Style="{StaticResource Kicker}"/>
                        <CheckBox Style="{StaticResource ToggleSwitch}" Content="Desktop-Kacheln anzeigen" IsChecked="{Binding Tiles.Visible}" Margin="0,4,0,8"/>
                        <CheckBox Style="{StaticResource ToggleSwitch}" Content="In-Game-Overlay (Strg+Umschalt+O)" x:Name="OverlayToggle" Click="Overlay_Click" Margin="0,0,0,6"/>
                        <CheckBox Style="{StaticResource ToggleSwitch}" Content="Overlay nur in Spielen" x:Name="OverlayGamesToggle" Click="OverlayGames_Click" Margin="0,0,0,10"/>
                        <WrapPanel>
                            <Button Content="Stresstest 5 min" Margin="0,0,8,8" Click="Stress_Click"/>
                            <Button Content="Problemlöser" Margin="0,0,8,8" Click="Go_Click" Tag="Problemlöser"/>
                            <Button Content="Protokoll" Margin="0,0,8,8" Click="Go_Click" Tag="Protokoll"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <StackPanel x:Name="SecHints">
                <TextBlock Text="WICHTIGE HINWEISE" Style="{StaticResource Kicker}" Margin="0,6,0,8" x:Name="HintsHead"/>
                <local:FindingsPanel x:Name="Hints" Area="All" MaxItems="4" Margin="0,0,12,0"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
