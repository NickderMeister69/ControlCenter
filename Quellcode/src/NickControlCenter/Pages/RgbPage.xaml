<UserControl x:Class="NickControlCenter.RgbPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NickControlCenter">
    <UserControl.Resources>
        <local:EqualsConverter x:Key="Eq"/>

        <!-- Farb-Chip -->
        <DataTemplate x:Key="ChipTemplate" DataType="{x:Type local:ColorItem}">
            <Grid Width="34" Height="34" Margin="0,0,6,6">
                <Border CornerRadius="5" Background="{Binding Brush}" BorderBrush="#40FFFFFF" BorderThickness="1"/>
            </Grid>
        </DataTemplate>

        <!-- Effekt-Editor (für alle Geräte und für einzelne Anschlüsse) -->
        <DataTemplate x:Key="EffectEditor" DataType="{x:Type local:EffectVM}">
            <StackPanel>
                <ListBox ItemsSource="{x:Static local:EffectVM.Choices}" SelectedValuePath="Type" SelectedValue="{Binding Type}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="2">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd" CornerRadius="3" Padding="6,7" Margin="1" Background="Transparent">
                                            <StackPanel>
                                                <TextBlock x:Name="ic" Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="15" HorizontalAlignment="Center" Foreground="{StaticResource SubTextBrush}"/>
                                                <TextBlock x:Name="tx" Text="{Binding Name}" FontSize="11.5" HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="{StaticResource SubTextBrush}"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/></Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                <Setter TargetName="ic" Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
                                                <Setter TargetName="tx" Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
                <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="2,8,0,0"/>

                <!-- Farben -->
                <StackPanel Visibility="{Binding ShowColors, Converter={StaticResource BoolToVis}}" Margin="0,14,0,0">
                    <TextBlock Text="{Binding ColorsLabel}" Style="{StaticResource Muted}" Margin="0,0,0,6"/>
                    <WrapPanel>
                        <ListBox ItemsSource="{Binding VisibleColors}" SelectedItem="{Binding Selected}" ItemTemplate="{StaticResource ChipTemplate}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ring" BorderThickness="2" BorderBrush="Transparent" CornerRadius="7" Padding="1" Margin="0,0,2,2">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="ring" Property="BorderBrush" Value="White"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                        <Button Width="34" Height="34" Padding="0" Margin="2,0,6,6" Content="+" FontSize="17" Click="AddColor_Click" ToolTip="Farbe hinzufügen"
                                Visibility="{Binding ShowAddColor, Converter={StaticResource BoolToVis}}" VerticalAlignment="Top"/>
                    </WrapPanel>

                    <!-- Farbwähler für die ausgewählte Farbe -->
                    <Border Style="{StaticResource SubCard}" Margin="0,6,0,0" DataContext="{Binding Selected}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Border Height="72" CornerRadius="4" Background="{Binding Brush}" BorderBrush="#40FFFFFF" BorderThickness="1"/>
                                <TextBox Text="{Binding HexInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" FontFamily="{StaticResource MonoFont}" FontSize="12" ToolTip="Hex-Code, z. B. #FF8800"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Farbton" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Style="{StaticResource ColorSlider}" Background="{StaticResource HueBrush}" Minimum="0" Maximum="360" Value="{Binding Hue}"/>
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Sättigung" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Style="{StaticResource ColorSlider}" Background="{Binding SatTrack}" Minimum="0" Maximum="100" Value="{Binding Sat}"/>
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Helligkeit" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Style="{StaticResource ColorSlider}" Background="{Binding ValTrack}" Minimum="0" Maximum="100" Value="{Binding Val}"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="R" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding R, UpdateSourceTrigger=LostFocus}" Width="52" Margin="6,0,12,0"/>
                                    <TextBlock Text="G" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding G, UpdateSourceTrigger=LostFocus}" Width="52" Margin="6,0,12,0"/>
                                    <TextBlock Text="B" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding B, UpdateSourceTrigger=LostFocus}" Width="52" Margin="6,0,12,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <!-- Schnellfarben -->
                    <WrapPanel Margin="0,8,0,0">
                        <WrapPanel.Resources>
                            <Style TargetType="Button">
                                <Setter Property="Width" Value="24"/>
                                <Setter Property="Height" Value="24"/>
                                <Setter Property="Margin" Value="0,0,5,5"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" CornerRadius="4" Background="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" BorderBrush="#40FFFFFF" BorderThickness="1"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="White"/><Setter TargetName="b" Property="BorderThickness" Value="2"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </WrapPanel.Resources>
                        <Button Tag="#FF0000" Click="Preset_Click"/><Button Tag="#FF4000" Click="Preset_Click"/><Button Tag="#FFB000" Click="Preset_Click"/>
                        <Button Tag="#FFFF00" Click="Preset_Click"/><Button Tag="#80FF00" Click="Preset_Click"/><Button Tag="#00FF00" Click="Preset_Click"/>
                        <Button Tag="#00FF80" Click="Preset_Click"/><Button Tag="#00FFFF" Click="Preset_Click"/><Button Tag="#0080FF" Click="Preset_Click"/>
                        <Button Tag="#0000FF" Click="Preset_Click"/><Button Tag="#8000FF" Click="Preset_Click"/><Button Tag="#FF00FF" Click="Preset_Click"/>
                        <Button Tag="#FF0060" Click="Preset_Click"/><Button Tag="#FFFFFF" Click="Preset_Click"/><Button Tag="#FFC890" Click="Preset_Click" ToolTip="Warmweiß"/>
                    </WrapPanel>
                    <!-- eigene, gespeicherte Farben -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Meine Farben" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ItemsControl x:Name="SavedList" ItemsSource="{Binding DataContext.SavedColors, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Tag="{Binding}" Click="Saved_Click" MouseRightButtonUp="Saved_Forget" Width="24" Height="24" Margin="0,0,5,0" Cursor="Hand"
                                            ToolTip="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="12" Background="{Binding}" BorderBrush="#60FFFFFF" BorderThickness="1"/>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Farbe merken" Style="{StaticResource GhostButton}" FontSize="12" Click="SaveColor_Click" ToolTip="Die ausgewählte Farbe zu „Meine Farben“ hinzufügen (Rechtsklick auf einen Punkt = entfernen)"/>
                        <Button Content="Entfernen" Style="{StaticResource GhostButton}" FontSize="12" Click="RemoveColor_Click" Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="◀" Style="{StaticResource GhostButton}" FontSize="11" Click="MoveLeft_Click" Visibility="{Binding ShowAddColor, Converter={StaticResource BoolToVis}}" ToolTip="Farbe nach vorne"/>
                        <Button Content="▶" Style="{StaticResource GhostButton}" FontSize="11" Click="MoveRight_Click" Visibility="{Binding ShowAddColor, Converter={StaticResource BoolToVis}}" ToolTip="Farbe nach hinten"/>
                    </StackPanel>
                </StackPanel>

                <!-- Parameter -->
                <Grid Margin="0,12,0,0" Visibility="{Binding ShowSeconds, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding SecondsLabel}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" Minimum="0.5" Maximum="30" Value="{Binding Seconds}"/>
                    <TextBlock Grid.Column="2" Text="{Binding SecondsText}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </Grid>
                <CheckBox Style="{StaticResource ToggleSwitch}" Content="Weich überblenden" IsChecked="{Binding Fade}" Margin="0,10,0,0" Visibility="{Binding ShowFade, Converter={StaticResource BoolToVis}}"/>
                <Grid Margin="0,12,0,0" Visibility="{Binding ShowSpeed, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Tempo" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" Minimum="0.1" Maximum="5" Value="{Binding Speed}"/>
                    <TextBlock Grid.Column="2" Text="{Binding SpeedText}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </Grid>
                <CheckBox Style="{StaticResource ToggleSwitch}" Content="Als Welle über die LEDs" IsChecked="{Binding Wave}" Margin="0,10,0,0" Visibility="{Binding ShowWave, Converter={StaticResource BoolToVis}}"/>
                <Grid Margin="0,10,0,0" Visibility="{Binding ShowTail, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Schweif" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" Minimum="5" Maximum="100" Value="{Binding Tail}"/>
                    <TextBlock Grid.Column="2" Text="{Binding TailText}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </Grid>
                <StackPanel Visibility="{Binding ShowTemp, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Text="Quelle" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" ItemsSource="{x:Static local:EffectVM.TempSourceNames}" SelectedIndex="{Binding TempSourceIndex}"/>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding TempRangeText}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Minimum="20" Maximum="90" Value="{Binding TempLow}" Margin="0,0,8,0" ToolTip="Ab hier erste Farbe (kühl)"/>
                        <Slider Grid.Column="2" Minimum="40" Maximum="105" Value="{Binding TempHigh}" ToolTip="Ab hier letzte Farbe (heiß)"/>
                    </Grid>
                </StackPanel>
                <StackPanel Visibility="{Binding ShowScreen, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
                    <Border Width="224" Height="126" HorizontalAlignment="Left" CornerRadius="4" BorderBrush="#40FFFFFF" BorderThickness="1" Margin="0,0,0,10" ClipToBounds="True"
                            DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" ToolTip="Live: so sieht die App gerade deinen Bildschirm">
                        <Grid Background="{Binding ScreenAll}">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="2*"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="2*"/><RowDefinition/></Grid.RowDefinitions>
                            <Border Grid.RowSpan="3" Background="{Binding ScreenLeft}"/>
                            <Border Grid.Column="2" Grid.RowSpan="3" Background="{Binding ScreenRight}"/>
                            <Border Grid.Column="1" Background="{Binding ScreenTop}"/>
                            <Border Grid.Column="1" Grid.Row="2" Background="{Binding ScreenBottom}"/>
                            <Border Grid.Column="1" Grid.Row="1" Background="{Binding ScreenCenter}" CornerRadius="3" Margin="4"/>
                        </Grid>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Text="Bereich" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" ItemsSource="{x:Static local:EffectVM.RegionNames}" SelectedIndex="{Binding RegionIndex}"/>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Farbstärke" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Minimum="50" Maximum="250" Value="{Binding Boost}"/>
                        <TextBlock Grid.Column="2" Text="{Binding BoostText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Reaktion" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Minimum="3" Maximum="100" Value="{Binding Reaction}"/>
                        <TextBlock Grid.Column="2" Text="{Binding ReactionText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,0,16,20">
        <StackPanel>
            <local:FindingsPanel Area="Rgb" Margin="0,0,12,4"/>

            <Grid Margin="0,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- Gemeinsamer Effekt -->
                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="EFFEKT FÜR ALLE GERÄTE" Style="{StaticResource Kicker}"/>
                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" HorizontalAlignment="Right" FontSize="12"/>
                        </Grid>
                        <Border Height="18" CornerRadius="3" Background="{Binding GlobalPreview}" Margin="0,4,0,14"/>
                        <ContentControl Content="{Binding Global}" ContentTemplate="{StaticResource EffectEditor}"/>
                    </StackPanel>
                </Border>

                <!-- Steuerung -->
                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="STEUERUNG" Style="{StaticResource Kicker}"/>
                            <CheckBox Style="{StaticResource ToggleSwitch}" Content="Beleuchtung an" IsChecked="{Binding Enabled}"/>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Helligkeit" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Brightness}"/>
                                <TextBlock Grid.Column="2" Text="{Binding BrightnessText}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </Grid>
                            <CheckBox Style="{StaticResource ToggleSwitch}" Content="Nachtmodus (Licht aus)" IsChecked="{Binding NightMode}" Margin="0,14,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="52,6,0,0" IsEnabled="{Binding NightMode}">
                                <TextBlock Text="von" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                <ComboBox ItemsSource="{x:Static local:RgbController.Hours}" SelectedItem="{Binding NightFrom}" Width="64" Margin="8,0"/>
                                <TextBlock Text="bis" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                <ComboBox ItemsSource="{x:Static local:RgbController.Hours}" SelectedItem="{Binding NightTo}" Width="64" Margin="8,0"/>
                                <TextBlock Text="Uhr" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource ToggleSwitch}" Content="Farben alle 5 s erneut senden" IsChecked="{Binding KeepAlive}" Margin="0,14,0,0"
                                      ToolTip="Hilft, wenn ein anderes Programm die Farben immer wieder zurücksetzt. Aus lassen, wenn es dadurch flackert."/>
                            <WrapPanel Margin="0,14,0,0">
                                <Button Content="Geräte neu suchen" Click="Rescan_Click" Margin="0,0,8,6"/>
                                <Button Content="Hardware-Liste" Click="Hardware_Click" Margin="0,0,8,6" ToolTip="Alle gefundenen USB-Geräte (zum Nachrüsten weiterer Hardware)"/>
                                <Button Content="RGB-Protokoll" Click="Log_Click" Margin="0,0,8,6"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="PROFILE" Style="{StaticResource Kicker}"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="ProfileName" ToolTip="Name für das aktuelle Licht-Profil, z. B. „Zocken“"/>
                                <Button Grid.Column="1" Content="Speichern" Margin="8,0,0,0" Click="SaveProfile_Click"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Profiles}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Content="Laden" Padding="10,4" FontSize="12" Click="LoadProfile_Click"/>
                                            <Button Grid.Column="2" Content="&#xE74D;" Style="{StaticResource IconButton}" Click="DeleteProfile_Click" ToolTip="Löschen"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="ERKANNTE HARDWARE" Style="{StaticResource Kicker}"/>
                            <ItemsControl ItemsSource="{Binding Hardware}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock FontWeight="SemiBold" TextWrapping="Wrap"><Run Text="{Binding Vendor, Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding Name, Mode=OneWay}"/></TextBlock>
                                            <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Keine RGB-Hardware gefunden. Unterstützt: ASUS Aura, MSI Mystic Light, Gigabyte RGB Fusion 2, ASRock Polychrome, Corsair, Lian Li, NZXT, Razer."
                                       Style="{StaticResource Caption}" Visibility="{Binding NoZones, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <TextBlock Text="ANSCHLÜSSE &amp; GERÄTE" Style="{StaticResource Kicker}" Margin="0,6,0,8" Visibility="{Binding HasZones, Converter={StaticResource BoolToVis}}"/>
            <ItemsControl ItemsSource="{Binding Zones}" Margin="0,0,12,0">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:LightZoneVM}">
                        <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBox Style="{StaticResource InlineEdit}" Text="{Binding DisplayName, UpdateSourceTrigger=LostFocus}" HorizontalAlignment="Left" MaxWidth="280"/>
                                        <TextBlock Text="{Binding SubTitle}" Style="{StaticResource Muted}"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Enabled}" VerticalAlignment="Top" ToolTip="Anschluss an/aus"/>
                                </Grid>
                                <Border Height="12" CornerRadius="3" Background="{Binding Preview}" Margin="0,10,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{Binding HealthBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Health}" Foreground="{Binding HealthBrush}" FontSize="11.5" Margin="6,0,0,0" TextWrapping="Wrap" MaxWidth="420"/>
                                </StackPanel>
                                <Grid Margin="0,10,0,0" Visibility="{Binding ShowLedSlider, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="LEDs" Style="{StaticResource Muted}" VerticalAlignment="Center" ToolTip="Wie viele LEDs am Anschluss hängen (alle Lüfter zusammen). Zu wenig = hintere Lüfter bleiben dunkel."/>
                                    <Slider Grid.Column="1" Minimum="1" Maximum="{Binding MaxLeds}" Value="{Binding LedCountValue}" IsSnapToTickEnabled="True" TickFrequency="1"/>
                                    <TextBlock Grid.Column="2" Text="{Binding LedText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,10,0,0" Visibility="{Binding ShowColorOrder, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Farbreihenfolge" Style="{StaticResource Muted}" VerticalAlignment="Center"
                                               ToolTip="Stimmen die Farben im Farbtest nicht (z. B. Rot leuchtet grün), hier umstellen"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{x:Static local:LightZoneVM.ColorOrderNames}" SelectedIndex="{Binding ColorOrder}"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding IsHub, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Lüfter am Hub" Style="{StaticResource Muted}" VerticalAlignment="Center" Width="100"/>
                                    <Button Content="−" Width="30" Padding="0,4" Click="FanMinus_Click"/>
                                    <TextBlock Text="{Binding FanCountText}" VerticalAlignment="Center" Margin="10,0"/>
                                    <Button Content="+" Width="30" Padding="0,4" Click="FanPlus_Click"/>
                                </StackPanel>
                                <Grid Margin="0,10,0,0" Visibility="{Binding ShowScreenRegion, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Bildbereich" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{x:Static local:LightZoneVM.ScreenRegionChoices}" SelectedIndex="{Binding ScreenRegionIndex}"/>
                                </Grid>
                                <WrapPanel Margin="0,12,0,0">
                                    <CheckBox Style="{StaticResource ToggleSwitch}" Content="Eigene Farben" IsChecked="{Binding OwnEffect}" Margin="0,0,22,6"
                                              ToolTip="Dieser Anschluss bekommt einen eigenen Effekt / eigene Farben"/>
                                    <CheckBox Style="{StaticResource ToggleSwitch}" Content="Flacker-Schutz" IsChecked="{Binding FlickerGuard}" Margin="0,0,22,6"
                                              ToolTip="Sendet seltener und nur bei sichtbarer Änderung. Einschalten, wenn dieser Lüfter flackert."/>
                                    <Button Content="Farbtest" Padding="10,4" FontSize="12" Click="ColorTest_Click" Margin="0,0,6,0" ToolTip="Alle Anschlüsse 2 s rot, grün, blau, weiß – zeigt, ob die Farben stimmen"/>
                                    <Button Content="Blinken lassen" Padding="10,4" FontSize="12" Click="Identify_Click" ToolTip="Lässt diesen Anschluss 3 s weiß blinken – so siehst du, welcher es ist"/>
                                </WrapPanel>
                                <Border Style="{StaticResource SubCard}" Margin="0,10,0,0" Visibility="{Binding OwnEffect, Converter={StaticResource BoolToVis}}">
                                    <ContentControl Content="{Binding Effect}" ContentTemplate="{StaticResource EffectEditor}"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
