<UserControl x:Class="NickControlCenter.FindingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ItemsControl x:Name="List">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{Binding SeverityBrush}" CornerRadius="5,0,0,5"/>
                        <StackPanel Grid.Column="1" Margin="16,12,16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding SeverityIcon}" Style="{StaticResource Icon}" Foreground="{Binding SeverityBrush}" Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding SeverityText}" FontSize="10" FontWeight="Bold" Foreground="{Binding SeverityBrush}" FontFamily="{StaticResource NumFont}"/>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" FontSize="14.5" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Ignorieren" Click="Ignore_Click" VerticalAlignment="Top" FontSize="12"
                                        ToolTip="Diesen Hinweis nicht mehr anzeigen (in Einstellungen → Problemlöser zurücksetzbar)"/>
                            </Grid>
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="12.5" Margin="0,6,0,0" LineHeight="18"/>
                            <TextBlock FontSize="12.5" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"
                                       Visibility="{Binding HasAdvice, Converter={StaticResource BoolToVis}}">
                                <Run Text="Lösung: " FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/><Run Text="{Binding Advice, Mode=OneWay}"/>
                            </TextBlock>
                            <Expander Header="Technische Details" Foreground="{StaticResource MutedBrush}" FontSize="11.5" Margin="0,6,0,0"
                                      Visibility="{Binding HasTechnical, Converter={StaticResource BoolToVis}}">
                                <TextBox Text="{Binding Technical, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="0,4,0,0"/>
                            </Expander>
                            <ItemsControl ItemsSource="{Binding Actions}" Margin="0,10,0,0">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,0,8,6" Padding="12,6" Click="Action_Click" Tag="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource BaseButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Primary}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,7,0"/>
                                                <TextBlock Text="{Binding Label}"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ProgressBar IsIndeterminate="True" Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding Result}" Foreground="{StaticResource GoodBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
