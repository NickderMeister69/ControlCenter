<UserControl x:Class="NickControlCenter.DriversPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NickControlCenter">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,0,16,20">
        <StackPanel Margin="0,0,12,0" MaxWidth="1000" HorizontalAlignment="Left">
            <Border Style="{StaticResource AccentCard}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="GRAFIKKARTE" Style="{StaticResource Kicker}"/>
                        <TextBlock Text="{Binding GpuName}" Style="{StaticResource H2}"/>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="NVIDIA: geprüft werden der Game-Ready- und der Studio-Treiber (offizielle NVIDIA-Treibersuche). AMD: neuester Adrenalin-Treiber von amd.com. Die App prüft beim Start automatisch und meldet Updates im Problemlöser."/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource AccentButton}" Content="Jetzt prüfen" Click="Check_Click" VerticalAlignment="Top" Padding="18,9"/>
                </Grid>
            </Border>
            <ProgressBar IsIndeterminate="True" Visibility="{Binding Checking, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12"/>
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource H2}"/>
                                    <Border HorizontalAlignment="Right" CornerRadius="3" Padding="8,2" BorderBrush="{Binding StateBrush}" BorderThickness="1">
                                        <TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}" FontWeight="SemiBold" FontSize="12"/>
                                    </Border>
                                </Grid>
                                <UniformGrid Columns="3" Margin="0,10,0,0">
                                    <StackPanel><TextBlock Text="Installiert" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Installed}" Style="{StaticResource BigNum}" FontSize="20"/></StackPanel>
                                    <StackPanel><TextBlock Text="Neueste Version" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Latest}" Style="{StaticResource BigNum}" FontSize="20"/></StackPanel>
                                    <StackPanel><TextBlock Text="Veröffentlicht" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Date}" FontSize="14" Margin="0,4,0,0"/></StackPanel>
                                </UniformGrid>
                                <TextBlock Margin="0,10,0,0" FontSize="13" Foreground="{DynamicResource AccentBrush}" Visibility="{Binding HasSizeInfo, Converter={StaticResource BoolToVis}}">
                                    <Run Text="Größe &amp; Dauer: " Foreground="{StaticResource MutedBrush}"/><Run Text="{Binding SizeInfo, Mode=OneWay}"/>
                                </TextBlock>
                                <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Margin="0,12,0,0" Visibility="{Binding Downloading, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Style="{StaticResource AccentButton}" Content="{Binding InstallText}" IsEnabled="{Binding CanInstall}" Click="Install_Click"
                                            ToolTip="Nur aktiv, wenn es einen neueren Treiber gibt"/>
                                    <Button Content="Details / Versionshinweise" Margin="8,0,0,0" Click="Details_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="ALLE ANDEREN TREIBER – CHIPSATZ, AUDIO, NETZWERK, BLUETOOTH, USB" Style="{StaticResource Kicker}"/>
                            <TextBlock x:Name="HwSummary" Text="Noch nicht geprüft" Style="{StaticResource H2}" FontSize="15" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button x:Name="HwCheck" Content="Treiber prüfen" Click="HwCheck_Click" Padding="12,5"/>
                            <Button x:Name="HwAll" Style="{StaticResource AccentButton}" Content="Alle installieren" Click="HwAll_Click" Padding="14,5" Margin="8,0,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,8"
                               Text="Die App fragt bei Windows Update nach neueren Treibern für jedes Gerät (geprüft und signiert von Microsoft – dieselben wie unter „Optionale Updates“). Gibt es einen, erscheint „Installieren“ – „Alle installieren“ macht alle auf einmal. Geräte ohne Update sind grün: dafür gibt es nichts Neueres. Nach Chipsatz- oder Netzwerktreibern kann ein Neustart nötig sein."/>
                    <WrapPanel x:Name="HwLinks" Margin="0,0,0,8" Visibility="Collapsed">
                        <Button x:Name="BoardBtn" Click="Link_Click" Margin="0,0,8,6"/>
                        <Button Content="Optionale Treiber in Windows Update" Click="Link_Click" Tag="ms-settings:windowsupdate-optionalupdates" Margin="0,0,8,6"/>
                    </WrapPanel>
                    <ItemsControl x:Name="HwList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:HwDriver}">
                                <Border Style="{StaticResource SubCard}" Margin="0,0,0,5" Padding="10,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="6"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Background="{Binding ShownBrush}" CornerRadius="2" Margin="0,2,0,2"/>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis"><Run Text="{Binding Category, Mode=OneWay}" Foreground="{StaticResource MutedBrush}"/><Run Text="  "/><Run Text="{Binding Device, Mode=OneWay}"/></TextBlock>
                                            <TextBlock Text="{Binding Line}" Style="{StaticResource Muted}" FontSize="11.5"/>
                                            <TextBlock Text="{Binding ShownAdvice}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" Visibility="{Binding HasShownAdvice, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="{Binding UpdateText}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource GoodBrush}" Visibility="{Binding HasUpdateText, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="{Binding Status}" FontSize="12" TextWrapping="Wrap" Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}"/>
                                            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,4,0,0" Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <Button Content="Installieren" Style="{StaticResource AccentButton}" Click="HwInstall_Click" Padding="14,4" FontSize="12"
                                                    IsEnabled="{Binding NotBusy}" Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}"/>
                                            <Button Content="{Binding LinkText}" Tag="{Binding Link}" Click="Link_Click" Padding="10,3" FontSize="11.5" Margin="0,4,0,0"
                                                    ToolTip="Öffnet die Download-Seite des Herstellers" Visibility="{Binding ShowLink, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="WEITERE LINKS" Style="{StaticResource Kicker}"/>
                    <WrapPanel>
                        <Button Content="NVIDIA App" Click="Link_Click" Tag="https://www.nvidia.com/de-de/software/nvidia-app/" Margin="0,0,8,6"/>
                        <Button Content="AMD Treiber-Seite (Auto-Erkennung)" Click="Link_Click" Tag="https://www.amd.com/de/support/download/drivers.html" Margin="0,0,8,6"/>
                        <Button Content="Intel Driver &amp; Support Assistant" Click="Link_Click" Tag="https://www.intel.de/content/www/de/de/support/detect.html" Margin="0,0,8,6"/>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" Text="Tipp: Bei Problemen nach einem Update hilft „Saubere Installation“ im Treiber-Installer."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
