<UserControl x:Class="NickControlCenter.DriversPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,0,16,20">
        <StackPanel Margin="0,0,12,0" MaxWidth="1000" HorizontalAlignment="Left">
            <Border Style="{StaticResource AccentCard}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="GRAFIKKARTE" Style="{StaticResource Kicker}"/>
                        <TextBlock Text="{Binding GpuName}" Style="{StaticResource H2}"/>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="NVIDIA: geprüft werden der Game-Ready- und der Studio-Treiber (offizielle NVIDIA-Treibersuche). AMD: neuester Adrenalin-Treiber von amd.com. Die App prüft beim Start automatisch und meldet Updates im Problemlöser."/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource AccentButton}" Content="Jetzt prüfen" Click="Check_Click" VerticalAlignment="Top" Padding="18,9"/>
                </Grid>
            </Border>
            <ProgressBar IsIndeterminate="True" Visibility="{Binding Checking, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12"/>
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource H2}"/>
                                    <Border HorizontalAlignment="Right" CornerRadius="3" Padding="8,2" BorderBrush="{Binding StateBrush}" BorderThickness="1">
                                        <TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}" FontWeight="SemiBold" FontSize="12"/>
                                    </Border>
                                </Grid>
                                <UniformGrid Columns="3" Margin="0,10,0,0">
                                    <StackPanel><TextBlock Text="Installiert" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Installed}" Style="{StaticResource BigNum}" FontSize="20"/></StackPanel>
                                    <StackPanel><TextBlock Text="Neueste Version" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Latest}" Style="{StaticResource BigNum}" FontSize="20"/></StackPanel>
                                    <StackPanel><TextBlock Text="Veröffentlicht" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Date}" FontSize="14" Margin="0,4,0,0"/></StackPanel>
                                </UniformGrid>
                                <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Margin="0,12,0,0" Visibility="{Binding Downloading, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Style="{StaticResource AccentButton}" Content="{Binding InstallText}" IsEnabled="{Binding CanInstall}" Click="Install_Click"
                                            ToolTip="Nur aktiv, wenn es einen neueren Treiber gibt"/>
                                    <Button Content="Details / Versionshinweise" Margin="8,0,0,0" Click="Details_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="WEITERE LINKS" Style="{StaticResource Kicker}"/>
                    <WrapPanel>
                        <Button Content="NVIDIA App" Click="Link_Click" Tag="https://www.nvidia.com/de-de/software/nvidia-app/" Margin="0,0,8,6"/>
                        <Button Content="AMD Treiber-Seite (Auto-Erkennung)" Click="Link_Click" Tag="https://www.amd.com/de/support/download/drivers.html" Margin="0,0,8,6"/>
                        <Button Content="Intel Driver &amp; Support Assistant" Click="Link_Click" Tag="https://www.intel.de/content/www/de/de/support/detect.html" Margin="0,0,8,6"/>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" Text="Tipp: Bei Problemen nach einem Update hilft „Saubere Installation“ im Treiber-Installer."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
