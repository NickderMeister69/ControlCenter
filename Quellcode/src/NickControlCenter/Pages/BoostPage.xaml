<UserControl x:Class="NickControlCenter.BoostPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NickControlCenter"
             xmlns:core="clr-namespace:NickControlCenter;assembly=NickControlCenter.Core">
    <UserControl.Resources>
        <local:EqualsConverter x:Key="Eq"/>
    </UserControl.Resources>
    <Grid Margin="28,0,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Kopf: BOOST -->
        <Border Style="{StaticResource AccentCard}" Margin="0,0,12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Status}" Style="{StaticResource H2}" FontSize="18"/>
                    <TextBlock Text="{Binding LastBoostText}" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                    <ItemsControl ItemsSource="{Binding Summary}" Margin="0,8,0,0" Visibility="{Binding HasSummary, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource PanelAltBrush}" CornerRadius="11" Padding="10,3" Margin="0,0,6,6">
                                    <TextBlock FontSize="12" Text="{Binding}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Jede Änderung wird vorher gesichert – „Alles zurücksetzen“ stellt den Originalzustand exakt wieder her." Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Alles zurücksetzen" Margin="0,0,10,0" Padding="16,10" Click="Undo_Click" IsEnabled="{Binding NotBusy}"/>
                    <Button Style="{StaticResource AccentButton}" Padding="34,12" FontSize="16" Click="Boost_Click" IsEnabled="{Binding NotBusy}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7FC;" Style="{StaticResource Icon}" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock Text="BOOST" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="2,0,0,8">
            <RadioButton Style="{StaticResource Tab}" Content="Spiele &amp; Profile" GroupName="BT" IsChecked="True" Checked="Tab_Checked" Tag="T2"/>
            <RadioButton Style="{StaticResource Tab}" Content="Windows-Optimierungen" GroupName="BT" Checked="Tab_Checked" Tag="T1"/>
            <RadioButton Style="{StaticResource Tab}" Content="Werkzeuge" GroupName="BT" Checked="Tab_Checked" Tag="T4"/>
            <RadioButton Style="{StaticResource Tab}" Content="Hintergrund-Apps" GroupName="BT" Checked="Tab_Checked" Tag="T5"/>
            <RadioButton Style="{StaticResource Tab}" Content="Protokoll" GroupName="BT" Checked="Tab_Checked" Tag="T6"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <!-- ======== Optimierungen ======== -->
            <ScrollViewer x:Name="T1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="0,0,12,0">
                    <local:FindingsPanel Area="Boost"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="BEIM BOOST AUSSERDEM" Style="{StaticResource Kicker}"/>
                            <WrapPanel>
                                <CheckBox Style="{StaticResource ToggleSwitch}" Content="Wiederherstellungspunkt" IsChecked="{Binding Settings.RestorePoint}" Margin="0,0,26,8"/>
                                <CheckBox Style="{StaticResource ToggleSwitch}" Content="Gewählte Hintergrund-Apps schließen" IsChecked="{Binding Settings.CloseAppsOnBoost}" Margin="0,0,26,8"/>
                                <CheckBox Style="{StaticResource ToggleSwitch}" Content="Temp-Dateien löschen" IsChecked="{Binding Settings.CleanOnBoost}" Margin="0,0,26,8"/>
                                <CheckBox Style="{StaticResource ToggleSwitch}" Content="RAM + Standby-Liste freigeben" IsChecked="{Binding Settings.RamOnBoost}" Margin="0,0,26,8"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Tweaks}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,10,10" Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsOn}" VerticalAlignment="Top" Margin="0,2,12,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <Border Background="{StaticResource InfoSoftBrush}" CornerRadius="3" Padding="6,1" Margin="0,0,6,0"><TextBlock Text="{Binding Group}" FontSize="10.5" Foreground="{StaticResource InfoBrush}"/></Border>
                                                <Border Background="{StaticResource WarnSoftBrush}" CornerRadius="3" Padding="6,1" Margin="0,0,6,0" Visibility="{Binding Restart, Converter={StaticResource BoolToVis}}"><TextBlock Text="Neustart" FontSize="10.5" Foreground="{StaticResource WarnBrush}"/></Border>
                                                <Border Background="{StaticResource BadSoftBrush}" CornerRadius="3" Padding="6,1" Visibility="{Binding Expert, Converter={StaticResource BoolToVis}}"><TextBlock Text="Experte" FontSize="10.5" Foreground="{StaticResource BadBrush}"/></Border>
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="{StaticResource GoodSoftBrush}" CornerRadius="3" Padding="7,2" VerticalAlignment="Top" Margin="8,0,0,0"
                                                Visibility="{Binding Active, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="AKTIV" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource GoodBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ======== Spiele & Profile ======== -->
            <Grid x:Name="T2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <!-- Liste -->
                <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="DEINE SPIELE" Style="{StaticResource Kicker}"/>
                            <TextBlock Text="{Binding GamesText}" Style="{StaticResource Muted}"/>
                            <CheckBox Style="{StaticResource ToggleSwitch}" Content="Auto-Boost beim Spielstart" IsChecked="{Binding Settings.AutoBoost}" Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding AutoStatus}" Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,10,0,8">
                            <Button Style="{StaticResource AccentButton}" Content="Spiel hinzufügen (exe wählen) …" Click="AddExe_Click" HorizontalAlignment="Stretch"/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ComboBox x:Name="KnownBox" ItemsSource="{x:Static local:BoostService.KnownGameNames}" ToolTip="Bekanntes Spiel aus der Liste wählen – Einstellungen sind schon darauf abgestimmt"/>
                                <Button Grid.Column="1" Content="+" Margin="6,0,0,0" Width="34" Click="AddKnown_Click" ToolTip="Ausgewähltes Spiel hinzufügen"/>
                            </Grid>
                        </StackPanel>
                        <ListBox Grid.Row="2" x:Name="GameList" SelectedItem="{Binding SelectedGame}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:GameVM}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Sub}" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding StateText}" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource AccentBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="3" Margin="0,8,0,0">
                            <TextBlock Text="{Binding SteamText}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="Mit Steam verbinden" Click="Steam_Click" x:Name="SteamBtn"/>
                                <Button Content="Trennen" Click="SteamOff_Click" Margin="6,0,0,0" x:Name="SteamOffBtn"/>
                                <Button Content="&#xE72C;" Style="{StaticResource IconButton}" Click="Rescan_Click" ToolTip="Spiele neu suchen (Steam, Epic, Riot)" Margin="6,0,0,0"/>
                            </StackPanel>
                            <CheckBox Content="Bekannte Spiele automatisch erkennen, sobald sie laufen" IsChecked="{Binding Settings.DetectRunning}" Margin="0,8,0,0" FontSize="12"/>
                            <CheckBox Content="Jedes Spiel erkennen (Spieleordner oder Vollbild) und automatisch boosten" IsChecked="{Binding Settings.DetectAnyGame}" Margin="0,4,0,0" FontSize="12"
                                      ToolTip="Startest du ein Spiel aus Steam, Epic, Riot, Xbox, GOG … oder läuft ein Programm länger als 15 s im Vollbild, bekommt es automatisch ein Profil (Boost + RAM freigeben)"/>
                            <CheckBox Content="Beim Spielen RAM automatisch freigeben, wenn er knapp wird (über 85 %)" IsChecked="{Binding Settings.RamWatchdog}" Margin="0,4,0,0" FontSize="12"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Profil des gewählten Spiels -->
                <TextBlock Grid.Column="1" x:Name="NoGame" Style="{StaticResource Muted}" Margin="12" TextWrapping="Wrap"
                           Text="Wähle links ein Spiel oder füge eins hinzu – z. B. VALORANT, Fortnite, CS2 oder jede beliebige exe. Für jedes Spiel stellst du ein eigenes Profil ein; beim Spielstart wird es automatisch aktiv."/>
                <ScrollViewer Grid.Column="1" x:Name="GameDetail" VerticalScrollBarVisibility="Auto" DataContext="{Binding SelectedGame}">
                    <StackPanel Margin="0,0,12,0">
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource H2}"/>
                                    <TextBlock Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"><Run Text="{Binding P.Source, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding P.Exe, Mode=OneWay, TargetNullValue='exe wird beim ersten Start erkannt'}"/></TextBlock>
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12" Visibility="{Binding HasSession, Converter={StaticResource BoolToVis}}">
                                        <Run Text="Letzte Sitzung: " Foreground="{StaticResource MutedBrush}"/><Run Text="{Binding LastSession, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button Style="{StaticResource AccentButton}" Content="Spielen" Click="Play_Click"/>
                                    <Button Content="&#xE74D;" Style="{StaticResource IconButton}" Click="Remove_Click" ToolTip="Aus der Liste entfernen" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="PROFIL FÜR DIESES SPIEL" Style="{StaticResource Kicker}"/>
                                <Border Style="{StaticResource SegmentBox}" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Segment}" Content="Max-FPS" GroupName="GP" Tag="0" Click="Preset_Click" IsChecked="{Binding PresetIndex, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=0}" ToolTip="Alles für maximale FPS und niedrigen Input-Lag – ideal für Shooter"/>
                                        <RadioButton Style="{StaticResource Segment}" Content="Ausgewogen" GroupName="GP" Tag="1" Click="Preset_Click" IsChecked="{Binding PresetIndex, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=1}" ToolTip="Mehr FPS, aber Grafik bleibt schön – ideal für Story-/Open-World-Spiele"/>
                                        <RadioButton Style="{StaticResource Segment}" Content="Eigene" GroupName="GP" Tag="2" Click="Preset_Click" IsChecked="{Binding PresetIndex, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=2}" ToolTip="Wird automatisch gewählt, sobald du unten etwas änderst"/>
                                        <RadioButton Style="{StaticResource Segment}" Content="Aus" GroupName="GP" Tag="3" Click="Preset_Click" IsChecked="{Binding PresetIndex, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=3}" ToolTip="Für dieses Spiel nichts tun"/>
                                    </StackPanel>
                                </Border>
                                <Button Content="✨  Empfohlene Einstellungen für meinen PC" HorizontalAlignment="Left" Margin="0,12,0,0" Click="Recommend_Click"
                                        ToolTip="Schaut auf Grafikkarte, Monitor (Auflösung und Hz), CPU und RAM und schlägt vor, wie dieses Spiel am besten läuft"/>
                                <Border Background="{StaticResource InfoSoftBrush}" CornerRadius="4" Padding="12,9" Margin="0,12,0,0" Visibility="{Binding HasHint, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="TIPPS FÜR DIESES SPIEL" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource InfoBrush}"/>
                                        <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" Margin="0,3,0,0" FontSize="12.5"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="BEIM SPIELSTART (WINDOWS)" Style="{StaticResource Kicker}"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="CPU-Priorität" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{x:Static core:GameCatalog.PriorityNames}" SelectedIndex="{Binding Priority}"/>
                                </Grid>
                                <UniformGrid Columns="2">
                                    <CheckBox Style="{StaticResource ToggleSwitch}" Content="Timer-Auflösung 0,5 ms" IsChecked="{Binding Timer}" Margin="0,0,10,10" ToolTip="Gleichmäßigere Frametimes, weniger Input-Lag – nur solange das Spiel läuft"/>
                                    <CheckBox Style="{StaticResource ToggleSwitch}" Content="Energieplan Höchstleistung" IsChecked="{Binding PowerPlan}" Margin="0,0,10,10" ToolTip="Nur solange das Spiel läuft, danach wieder dein normaler Plan"/>
                                    <CheckBox Style="{StaticResource ToggleSwitch}" Content="Hintergrund-Apps schließen" IsChecked="{Binding CloseApps}" Margin="0,0,10,10" ToolTip="Die im Reiter „Hintergrund-Apps“ angehakten Programme"/>
                                    <CheckBox Style="{StaticResource ToggleSwitch}" Content="RAM + Standby-Liste freigeben" IsChecked="{Binding CleanRam}" Margin="0,0,10,10"/>
                                    <CheckBox Style="{StaticResource ToggleSwitch}" Content="Desktop-Kacheln pausieren" IsChecked="{Binding PauseTiles}" Margin="0,0,10,10" ToolTip="Kacheln werden während des Spiels ausgeblendet und danach wieder gezeigt"/>
                                    <CheckBox Style="{StaticResource ToggleSwitch}" Content="Vollbild-Optimierung aus + starke GPU" IsChecked="{Binding ExeTweaks}" Margin="0,0,10,10" ToolTip="Windows-Einträge für die Spiel-exe (wirkt ab dem nächsten Start)"/>
                                    <CheckBox Style="{StaticResource ToggleSwitch}" Content="Benachrichtigungen aus" IsChecked="{Binding QuietNotifications}" Margin="0,0,10,10" ToolTip="Keine Windows-Popups während des Spiels – danach wieder an"/>
                                    <CheckBox Style="{StaticResource ToggleSwitch}" Content="Hintergrund-Apps ausbremsen" IsChecked="{Binding ThrottleBackground}" Margin="0,0,10,10" ToolTip="Statt zu schließen: die angehakten Hintergrund-Programme bekommen niedrige Priorität (Discord, Browser bleiben offen)"/>
                                    <CheckBox Style="{StaticResource ToggleSwitch}" Content="Nur Leistungskerne (P-Kerne)" IsChecked="{Binding PCoresOnly}" Margin="0,0,10,10" Visibility="{Binding HybridCpu, Converter={StaticResource BoolToVis}}"
                                              ToolTip="Intel 12./13./14. Gen: Spiel läuft nur auf den schnellen P-Kernen – kann Ruckler durch E-Kerne verhindern. Bei manchen Spielen besser aus, ausprobieren."/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="BELEUCHTUNG BEIM SPIELEN" Style="{StaticResource Kicker}"/>
                                <TextBlock Style="{StaticResource Caption}" Text="Startet das Spiel, wechselt die RGB-Beleuchtung – danach kommt deine normale Beleuchtung zurück."/>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Beleuchtung" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{x:Static local:GameVM.RgbModeNames}" SelectedIndex="{Binding RgbMode}"/>
                                </Grid>
                                <Grid Margin="0,8,0,0" Visibility="{Binding ShowRgbColor, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="32"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Farbe (Hex)" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Width="22" Height="22" CornerRadius="4" Background="{Binding RgbBrush}"/>
                                    <TextBox Grid.Column="2" Text="{Binding RgbColor, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource MonoFont}"/>
                                </Grid>
                                <Grid Margin="0,8,0,0" Visibility="{Binding ShowRgbProfile, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="RGB-Profil" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding RgbProfileNames}" SelectedItem="{Binding RgbProfile}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="GRAFIK IM SPIEL" Style="{StaticResource Kicker}"/>
                                <TextBlock Text="{Binding ConfigText}" Style="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11.5"/>
                                <StackPanel Visibility="{Binding CanGraphics, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                                    <CheckBox Style="{StaticResource ToggleSwitch}" Content="Grafik-Config dieses Spiels anpassen" IsChecked="{Binding Graphics}"/>
                                    <Grid Margin="0,10,0,0" IsEnabled="{Binding Graphics}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                        <TextBlock Text="Grafik-Qualität" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{x:Static core:GameCatalog.QualityNames}" SelectedIndex="{Binding GfxQuality}" Margin="0,0,0,6"/>
                                        <TextBlock Grid.Row="1" Text="FPS-Limit" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{x:Static core:GameCatalog.FpsLimitNames}" SelectedIndex="{Binding FpsLimit}" Margin="0,0,0,6"/>
                                        <TextBlock Grid.Row="2" Text="Auflösungs-Skalierung" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{x:Static core:GameCatalog.ResolutionNames}" SelectedIndex="{Binding ResScale}"/>
                                    </Grid>
                                    <CheckBox Style="{StaticResource ToggleSwitch}" Content="V-Sync aus" IsChecked="{Binding VsyncOff}" Margin="0,10,0,0" IsEnabled="{Binding Graphics}"/>
                                    <CheckBox Style="{StaticResource ToggleSwitch}" Content="Bewegungs-/Tiefenunschärfe, Linsenreflexe aus" IsChecked="{Binding PostFxOff}" Margin="0,8,0,0" IsEnabled="{Binding Graphics}"
                                              Visibility="{Binding EngineIniOk, Converter={StaticResource BoolToVis}}"/>
                                    <CheckBox Style="{StaticResource ToggleSwitch}" Content="Volumetrische Wolken &amp; Nebel aus (UE5, +5–15 FPS)" IsChecked="{Binding VolumetricsOff}" Margin="0,8,0,0" IsEnabled="{Binding Graphics}"
                                              Visibility="{Binding IsUe5, Converter={StaticResource BoolToVis}}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="Jetzt in die Config schreiben" Click="ApplyGfx_Click" ToolTip="Spiel muss geschlossen sein. Passiert sonst automatisch über „Spielen“ und beim BOOST."/>
                                        <Button Content="Original wiederherstellen" Click="RestoreGfx_Click" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <CheckBox Style="{StaticResource ToggleSwitch}" Content="Intro-Videos überspringen" IsChecked="{Binding SkipIntros}" Margin="0,10,0,0"
                                          Visibility="{Binding HasIntros, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Visibility="{Binding CanGraphics, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="FEINEINSTELLUNGEN (UNREAL ENGINE)" Style="{StaticResource Kicker}"/>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                           Text="Jede Grafik-Kategorie einzeln und Profi-Einstellungen, die es im Spielmenü nicht gibt. Fertige Kombination wählen oder selbst zusammenstellen – wird beim „Spielen“ bzw. mit „Jetzt in die Config schreiben“ übernommen (Spiel muss zu sein)."/>
                                <TextBlock Text="Fertige Kombinationen" Style="{StaticResource Muted}" Margin="0,10,0,4"/>
                                <ItemsControl ItemsSource="{Binding LookPresets}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <Button Content="{Binding Name}" Click="LookPreset_Click" HorizontalAlignment="Stretch" Margin="0,0,10,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding LookPresetText}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                    <Button Content="Alles zurück auf Standard" Margin="12,0,0,0" Padding="8,3" FontSize="12" Click="ClearFine_Click"/>
                                </StackPanel>
                                <TextBlock Text="Grafik-Kategorien einzeln" Style="{StaticResource Muted}" Margin="0,12,0,4"/>
                                <ItemsControl ItemsSource="{Binding SgItems}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,12,6" ToolTip="{Binding Hint}">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                                <ComboBox Grid.Column="1" ItemsSource="{x:Static core:UnrealTweaks.LevelNames}" SelectedIndex="{Binding Index}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Visibility="{Binding EngineIniOk, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Profi-Einstellungen (Konsolenvariablen in der Engine.ini)" Style="{StaticResource Muted}" Margin="0,12,0,4"/>
                                    <ItemsControl ItemsSource="{Binding TweakItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding On}" VerticalAlignment="Top" Margin="0,2,10,0"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Margin="8,0,0,0" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding Gain}" FontWeight="SemiBold" Foreground="{StaticResource GoodBrush}" HorizontalAlignment="Right"/>
                                                        <TextBlock Text="{Binding LookText}" FontSize="10.5" Foreground="{Binding LookBrush}" HorizontalAlignment="Right"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Button Content="Als Konsolenbefehle kopieren" Click="CopyConsole_Click" ToolTip="Zum Ausprobieren im laufenden Spiel: Konsole öffnen (ARK: Tab bzw. ^), Befehl einfügen. Gilt dann bis zum Neustart."/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Visibility="{Binding HasLaunchOptions, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="EMPFOHLENE STARTOPTIONEN" Style="{StaticResource Kicker}"/>
                                <TextBlock Style="{StaticResource Caption}" Text="Steam: Rechtsklick aufs Spiel → Eigenschaften → Startoptionen → einfügen."/>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding LaunchOptions, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource MonoFont}"/>
                                    <Button Grid.Column="1" Content="Kopieren" Click="CopyLaunch_Click" Margin="8,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ======== Werkzeuge ======== -->
            <ScrollViewer x:Name="T4" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <UniformGrid Columns="2" Margin="0,0,12,0" VerticalAlignment="Top">
                    <Border Style="{StaticResource Card}" Margin="0,0,10,10">
                        <StackPanel>
                            <TextBlock Text="TEMPORÄRE DATEIEN" Style="{StaticResource Kicker}"/>
                            <TextBlock Style="{StaticResource Caption}" Text="Löscht Windows- und Benutzer-Temp (Dateien älter als 1 Stunde). Läuft im Hintergrund – die App bleibt bedienbar, gesperrte Dateien werden übersprungen."/>
                            <ProgressBar Value="{Binding CleanProgress, Mode=OneWay}" Maximum="100" Margin="0,10,0,6"/>
                            <TextBlock Text="{Binding CleanStatus}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Style="{StaticResource AccentButton}" Content="Jetzt aufräumen" Click="Clean_Click"/>
                                <Button Content="Abbrechen" Margin="8,0,0,0" Click="CleanCancel_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,10,10">
                        <StackPanel>
                            <TextBlock Text="SHADER-CACHE" Style="{StaticResource Kicker}"/>
                            <TextBlock Style="{StaticResource Caption}" Text="NVIDIA, AMD, Intel und DirectX. Hilft bei Rucklern nach Treiber-Updates. Beim nächsten Spielstart werden Shader neu erstellt (erster Start dauert kurz länger)."/>
                            <Button Content="Shader-Cache leeren" Click="Shader_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,10,10">
                        <StackPanel>
                            <TextBlock Text="ARBEITSSPEICHER" Style="{StaticResource Kicker}"/>
                            <TextBlock Style="{StaticResource Caption}" Text="Gibt ungenutzten RAM frei und leert die Standby-Liste (wie ISLC) – hilft gegen Ruckler bei 16 GB RAM oder weniger. Spiele und Anti-Cheat werden nie angefasst."/>
                            <Button Content="RAM freigeben" Click="Ram_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,10,10">
                        <StackPanel>
                            <TextBlock Text="NETZWERK" Style="{StaticResource Kicker}"/>
                            <TextBlock Style="{StaticResource Caption}" Text="DNS-Cache leeren und Ping zu Cloudflare, Google, Steam und Epic messen."/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="DNS leeren" Click="Dns_Click"/>
                                <Button Content="Ping-Test" Click="Ping_Click" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="PingText" Style="{StaticResource Muted}" Margin="0,8,0,0" FontFamily="{StaticResource MonoFont}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,10,10">
                        <StackPanel>
                            <TextBlock Text="WIEDERHERSTELLUNGSPUNKT" Style="{StaticResource Kicker}"/>
                            <TextBlock Style="{StaticResource Caption}" Text="Windows-Sicherung vor größeren Änderungen (Windows erlaubt einen pro 24 Stunden)."/>
                            <Button Content="Punkt erstellen" Click="Restore_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,10,10">
                        <StackPanel>
                            <TextBlock Text="TIMER-AUFLÖSUNG" Style="{StaticResource Kicker}"/>
                            <TextBlock Style="{StaticResource Caption}" Text="Setzt den Windows-Zeitgeber sofort auf 0,5 ms (gleichmäßigere Frametimes). Gilt solange die App läuft."/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Jetzt aktivieren" Click="TimerOn_Click"/>
                                <Button Content="Zurück auf Standard" Click="TimerOff_Click" Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </ScrollViewer>

            <!-- ======== Hintergrund-Apps ======== -->
            <ScrollViewer x:Name="T5" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <Border Style="{StaticResource Card}" Margin="0,0,12,0" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="LAUFENDE HINTERGRUND-PROGRAMME" Style="{StaticResource Kicker}"/>
                        <TextBlock Style="{StaticResource Caption}" Text="Alle Programme, die gerade laufen – das größte zuerst. Häkchen = wird beim Boost bzw. Spielstart geschlossen. Programme mit offenem Fenster werden nur sanft geschlossen (wie mit X – nichts geht verloren), reine Hintergrund-Programme werden beendet."/>
                        <ItemsControl ItemsSource="{Binding BackgroundApps}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <CheckBox IsChecked="{Binding Selected}" Content="{Binding Name}"/>
                                        <TextBlock Text="{Binding MbText}" Style="{StaticResource Muted}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="NoApps" Text="Keine Programme im Hintergrund gefunden – sehr gut!" Foreground="{StaticResource GoodBrush}" Margin="0,8,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Liste aktualisieren" Click="RefreshApps_Click"/>
                            <Button Content="Ausgewählte jetzt schließen" Click="CloseApps_Click" Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <!-- ======== Protokoll ======== -->
            <Border x:Name="T6" Style="{StaticResource Card}" Margin="0,0,12,0" Visibility="Collapsed">
                <ListBox ItemsSource="{Binding Output}" FontFamily="{StaticResource MonoFont}" FontSize="12"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
