<Window x:Class="NickControlCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NickControlCenter"
        Title="Control Center"
        Width="1320" Height="860" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Icon="pack://application:,,,/Assets/app.ico"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ======================= Seitenleiste ======================= -->
            <Border Background="{StaticResource SideBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Logo -->
                    <StackPanel Orientation="Horizontal" Margin="18,14,0,18">
                        <Grid Width="30" Height="30">
                            <Path Data="M15,1 L28,8.5 L28,21.5 L15,29 L2,21.5 L2,8.5 Z" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.2" Fill="#0E1219"/>
                            <TextBlock Text="CC" FontFamily="{StaticResource NumFont}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="CONTROL" FontFamily="{StaticResource NumFont}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="CENTER" FontFamily="{StaticResource NumFont}" FontSize="10.5" Foreground="{StaticResource SubTextBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="NavPanel">
                            <TextBlock Text="ÜBERSICHT" Style="{StaticResource Muted}" FontSize="10" Margin="24,0,0,4"/>
                            <RadioButton Style="{StaticResource NavItem}" Tag="&#xE80F;" Content="Dashboard" x:Name="NavDashboard" Checked="Nav_Checked"/>
                            <RadioButton Style="{StaticResource NavItem}" Tag="&#xE9D9;" Content="Monitor" x:Name="NavMonitor" Checked="Nav_Checked"/>
                            <TextBlock Text="STEUERUNG" Style="{StaticResource Muted}" FontSize="10" Margin="24,12,0,4"/>
                            <RadioButton Style="{StaticResource NavItem}" Tag="&#xE7FC;" Content="FPS-Boost" x:Name="NavBoost" Checked="Nav_Checked"/>
                            <RadioButton Style="{StaticResource NavItem}" Tag="&#xE9CA;" Content="Lüfter" x:Name="NavFans" Checked="Nav_Checked"/>
                            <RadioButton Style="{StaticResource NavItem}" Tag="&#xE781;" Content="Beleuchtung" x:Name="NavRgb" Checked="Nav_Checked"/>
                            <RadioButton Style="{StaticResource NavItem}" Tag="&#xE945;" Content="Tweaker" x:Name="NavTweaker" Checked="Nav_Checked"/>
                            <RadioButton Style="{StaticResource NavItem}" Tag="&#xE7BA;" Content="Stresstest" x:Name="NavStress" Checked="Nav_Checked"/>
                            <TextBlock Text="WINDOWS" Style="{StaticResource Muted}" FontSize="10" Margin="24,12,0,4"/>
                            <RadioButton Style="{StaticResource NavItem}" Tag="&#xE790;" Content="Design &amp; Farben" x:Name="NavCustomize" Checked="Nav_Checked"/>
                            <RadioButton Style="{StaticResource NavItem}" Tag="&#xF0E2;" Content="Desktop-Kacheln" x:Name="NavTiles" Checked="Nav_Checked"/>
                            <TextBlock Text="SYSTEM" Style="{StaticResource Muted}" FontSize="10" Margin="24,12,0,4"/>
                            <Grid>
                                <RadioButton Style="{StaticResource NavItem}" Tag="&#xE90F;" Content="Problemlöser" x:Name="NavDiagnose" Checked="Nav_Checked"/>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0" MinWidth="20" Height="18" CornerRadius="9" Padding="5,0"
                                        Background="{StaticResource WarnBrush}" IsHitTestVisible="False"
                                        DataContext="{x:Static local:DiagnosticsService.Instance}"
                                        Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding Badge}" FontSize="10.5" FontWeight="Bold" Foreground="#111" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <RadioButton Style="{StaticResource NavItem}" Tag="&#xE7C3;" Content="Treiber" x:Name="NavDrivers" Checked="Nav_Checked"/>
                            <RadioButton Style="{StaticResource NavItem}" Tag="&#xE9F9;" Content="Protokoll" x:Name="NavLogs" Checked="Nav_Checked"/>
                            <RadioButton Style="{StaticResource NavItem}" Tag="&#xE713;" Content="Einstellungen" x:Name="NavSettings" Checked="Nav_Checked"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Mini-Status + Beenden -->
                    <StackPanel Grid.Row="2" Margin="16,8,16,14">
                        <Border Style="{StaticResource SubCard}" Padding="10,8" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="CPU" Style="{StaticResource Muted}" FontSize="10"/>
                                    <TextBlock x:Name="MiniCpu" Text="–" FontFamily="{StaticResource NumFont}" FontSize="17" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="GPU" Style="{StaticResource Muted}" FontSize="10"/>
                                    <TextBlock x:Name="MiniGpu" Text="–" FontFamily="{StaticResource NumFont}" FontSize="17" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="MiniSource" Style="{StaticResource Muted}" FontSize="10.5" Margin="2,0,0,10"/>
                        <Button Style="{StaticResource DangerButton}" HorizontalAlignment="Stretch" Click="Exit_Click"
                                ToolTip="App komplett schließen (X oben rechts lässt sie im Hintergrund weiterlaufen)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7E8;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                                <TextBlock Text="App beenden"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ======================= Inhalt ======================= -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Titelleiste -->
                <Grid>
                    <TextBlock x:Name="Crumb" Margin="28,0,0,0" VerticalAlignment="Center" Style="{StaticResource Muted}" FontSize="11.5"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource TitleButton}" Content="&#xE921;" Click="Min_Click" ToolTip="Minimieren"/>
                        <Button Style="{StaticResource TitleButton}" Content="&#xE922;" Click="Max_Click" ToolTip="Maximieren"/>
                        <Button Style="{StaticResource CloseTitleButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Schließen – läuft im Hintergrund weiter"/>
                    </StackPanel>
                </Grid>

                <!-- Seitenkopf -->
                <Grid Grid.Row="1" Margin="28,2,28,14">
                    <StackPanel>
                        <TextBlock x:Name="PageTitle" Style="{StaticResource H1}"/>
                        <TextBlock x:Name="PageSub" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>

                <ContentControl x:Name="PageHost" Grid.Row="2" Focusable="False"/>

                <!-- Toast -->
                <Border x:Name="ToastBox" Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,22"
                        Background="#1A212B" BorderBrush="{DynamicResource AccentDimBrush}" BorderThickness="1" CornerRadius="4" Padding="16,10"
                        Visibility="Collapsed" MaxWidth="640">
                    <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.55"/></Border.Effect>
                    <TextBlock x:Name="ToastText" TextWrapping="Wrap"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
